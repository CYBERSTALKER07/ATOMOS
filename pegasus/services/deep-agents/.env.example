# Required for the default xAI / Grok model (never commit real keys).
# Get a key at https://console.x.ai/ — then replace the placeholder below.
XAI_API_KEY=xai-your-key-here

# Optional model override (default: grok-4.5)
DEEP_AGENTS_MODEL=grok-4.5

# Optional monorepo roots (auto-detected from package location if unset)
# VOID_ROOT=/Users/shakhzod/Desktop/V.O.I.D
# PEGASUSX_ROOT=/Users/shakhzod/Desktop/V.O.I.D/pegasusX

# Optional: other providers if you pass model="openai:..." / "anthropic:..."
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional: LangSmith tracing for Deep Agent runs
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=pegasusx-ecosystem-auditor
