# Copy to staging.tfvars (gitignored) and fill before: make phase0-plan / phase0-apply
#
#   cp staging.tfvars.example staging.tfvars

project_id   = "your-gcp-project-id"
tenant_slug  = "staging"
environment  = "staging"
region       = "asia-south1"

# GS-C1 — live/staging cell. New cells set gsm_regional_only=true, vpc_custom_mode=true,
# and a terraform_state_prefix that is NOT pegasusx/ssmr (see backend-cell.example.hcl).
cell_id                = "uz"
api_hostname           = "api.pegasusx.app"
k8s_namespace          = "pegasusx"
terraform_state_prefix = "pegasusx/ssmr"
gsm_regional_only      = false
vpc_custom_mode        = false

# GKE + Artifact Registry (required for Phase 0 deploy)
enable_gke = true

# Budget — year-1 pilot envelope ($1,500 target; $1,700 upper guardrail per CLOUD_BUDGET_MODEL.md)
monthly_budget_usd  = 1500
billing_account_id  = "XXXXXX-XXXXXX-XXXXXX"
budget_alert_emails = ["ops@example.com"]

# Kafka — prefer GCP Managed (enable_managed_kafka=true) over Confluent for HA RF=3.
enable_managed_kafka    = true
kafka_bootstrap_servers = "" # filled from terraform output managed_kafka_bootstrap after apply
kafka_topic_main        = "staging.events.orders"
kafka_topic_main_dlq    = "staging.events.orders-dlq"
kafka_topic_spatial     = "staging.events.spatial"
kafka_topic_realtime    = "staging.events.realtime"
kafka_topic_webhooks    = "staging.events.webhooks"
kafka_topic_freeze_locks = "staging.events.freeze-locks"
kafka_topic_inventory_import = "staging.events.inventory-import"

# Firebase + Maps (seed GSM on apply — rotate in console after first boot)
firebase_project_id   = "your-firebase-project-id"
firebase_auth_enabled = true
google_maps_api_key   = "" # set via TF_VAR_google_maps_api_key or -var

# Runtime secrets — prefer TF_VAR_* env vars over committing values:
#   export TF_VAR_jwt_secret=...
#   export TF_VAR_global_pay_webhook_secret=...
jwt_secret                = ""
global_pay_webhook_secret = ""

# Observability (recommended for staging)
enable_observability_resources = true
alert_notification_channels    = []
ai_worker_monitoring_host      = "" # set after ingress IP/DNS exists
