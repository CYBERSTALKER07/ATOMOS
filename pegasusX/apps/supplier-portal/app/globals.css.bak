@import "tailwindcss";
@import "@pegasusx/ui-kit/styles/desktop-foundation.css";
@import "@pegasusx/ui-kit/styles/auth-layout.css";

/* M3 compatibility layer on top of desk tokens */
:root {
  --color-md-primary: var(--desk-accent);
  --color-md-on-primary: var(--desk-accent-on);
  --color-md-primary-container: var(--desk-accent-soft);
  --color-md-on-primary-container: var(--desk-accent-strong);

  --color-md-surface: var(--desk-canvas);
  --color-md-on-surface: var(--desk-text-primary);
  --color-md-surface-container-low: var(--desk-surface-subtle);
  --color-md-surface-container: var(--desk-surface);
  --color-md-surface-container-high: var(--desk-surface-subtle);
  --color-md-surface-container-highest: var(--desk-border);

  --color-md-outline: var(--desk-text-secondary);
  --color-md-outline-variant: var(--desk-border);

  --color-md-error: var(--desk-danger);
  --color-md-on-error: #ffffff;
  --color-md-success: var(--desk-success);
  --color-md-warning: var(--desk-warning);
  --color-md-info: var(--desk-info);
}

html.theme-dark {
  --desk-canvas: #0f1115;
  --desk-surface: #171a21;
  --desk-surface-subtle: #1d2129;
  --desk-surface-sunken: #12151a;
  --desk-border: #2a3038;
  --desk-border-strong: #3a424f;
  --desk-text-primary: #f3f4f6;
  --desk-text-secondary: #b6beca;
  --desk-text-tertiary: #8b95a5;
}

html,
body {
  margin: 0;
  padding: 0;
  background: var(--desk-canvas);
  color: var(--desk-text-primary);
  font-family: var(--desktop-font-sans, ui-sans-serif, system-ui, sans-serif);
  -webkit-font-smoothing: antialiased;
}

.md-typescale-display-large  { font-size: 57px; line-height: 64px; letter-spacing: -0.25px; font-weight: 400; }
.md-typescale-headline-large { font-size: 32px; line-height: 40px; font-weight: 400; }
.md-typescale-headline-medium { font-size: 28px; line-height: 36px; font-weight: 400; }
.md-typescale-headline-small { font-size: 24px; line-height: 32px; font-weight: 400; }
.md-typescale-title-large    { font-size: 22px; line-height: 28px; font-weight: 500; }
.md-typescale-title-medium   { font-size: 16px; line-height: 24px; letter-spacing: 0.15px; font-weight: 500; }
.md-typescale-body-large     { font-size: 16px; line-height: 24px; letter-spacing: 0.5px; }
.md-typescale-body-medium    { font-size: 14px; line-height: 20px; letter-spacing: 0.25px; }
.md-typescale-body-small     { font-size: 12px; line-height: 16px; }
.md-typescale-label-large    { font-size: 14px; line-height: 20px; letter-spacing: 0.1px; font-weight: 500; }
.md-typescale-label-medium   { font-size: 12px; line-height: 16px; letter-spacing: 0.5px; font-weight: 500; }
.md-typescale-label-small    { font-size: 11px; line-height: 16px; letter-spacing: 0.5px; font-weight: 500; }

.md-shape-md { border-radius: var(--radius-md); }
.md-shape-lg { border-radius: var(--radius-lg); }
.md-shape-full { border-radius: var(--radius-pill); }

.md-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 40px;
  padding: 0 24px;
  border-radius: var(--radius-pill);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  border: 1px solid transparent;
}
.md-btn-filled {
  background: var(--desk-accent);
  color: var(--desk-accent-on);
}
.md-btn-outlined {
  background: transparent;
  color: var(--desk-text-primary);
  border-color: var(--desk-border);
}
.md-btn-text {
  background: transparent;
  color: var(--desk-accent-strong);
  padding: 0 12px;
}
.md-btn:disabled { opacity: 0.38; cursor: not-allowed; }

.md-input-outlined {
  display: block;
  width: 100%;
  height: 56px;
  padding: 0 16px;
  background: var(--desk-surface);
  color: var(--desk-text-primary);
  border: 1px solid var(--desk-border);
  border-radius: var(--radius-sm);
  font-size: 16px;
  outline: none;
}
.md-input-outlined:focus {
  border-color: var(--desk-accent);
  box-shadow: 0 0 0 1px var(--desk-accent);
}

.md-card {
  background: var(--desk-surface);
  border: 1px solid var(--desk-border);
  border-radius: var(--radius-lg);
}

.md-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding: 0 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--desk-border);
  background: var(--desk-surface);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
}
.md-chip[aria-pressed="true"] {
  background: var(--desk-accent-soft);
  border-color: var(--desk-accent);
  color: var(--desk-accent-strong);
}

.md-menu {
  position: absolute;
  z-index: 50;
  background: var(--desk-surface);
  border: 1px solid var(--desk-border);
  border-radius: var(--radius-md);
  padding: 4px;
  box-shadow: var(--shadow-overlay);
}

.md-menu-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  color: var(--desk-text-primary);
  text-decoration: none;
  background: transparent;
  border: none;
  cursor: pointer;
  font: 500 14px/20px var(--desktop-font-sans);
}
.md-menu-item:hover {
  background: var(--desk-surface-subtle);
}

.md-search-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 16px;
  background: var(--desk-surface);
}
.md-search-bar input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font: var(--type-body-md);
  color: var(--desk-text-primary);
}

.desk-page-header {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.desk-page-title {
  font: var(--type-heading-md);
  color: var(--desk-text-primary);
  margin: 0;
}

.desk-page-subtitle {
  font: var(--type-body-md);
  color: var(--desk-text-secondary);
  margin: var(--space-2) 0 0;
}

.desk-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.desk-data-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--desk-surface);
  border: 1px solid var(--desk-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.desk-data-table th,
.desk-data-table td {
  padding: 14px 16px;
  text-align: left;
  border-bottom: 1px solid var(--desk-border);
  font: var(--type-body-md);
}

.desk-data-table th {
  font: 600 12px/16px var(--desktop-font-sans);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--desk-text-tertiary);
  background: var(--desk-surface-subtle);
}

.desk-data-table tr:last-child td {
  border-bottom: none;
}

.desk-table {
  width: 100%;
  border-collapse: collapse;
}

.desk-table th,
.desk-table td {
  padding: 14px 16px;
  text-align: left;
  border-bottom: 1px solid var(--desk-border);
  font: var(--type-body-md);
}

.desk-table th {
  font: 600 12px/16px var(--desktop-font-sans);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--desk-text-tertiary);
  background: var(--desk-surface-subtle);
}

.desk-table tr:last-child td {
  border-bottom: none;
}

.md-kpi-value {
  font: var(--type-display-sm);
  letter-spacing: -0.02em;
  color: var(--desk-text-primary);
}
