{
  "identifier": "default",
  "description": "Default capabilities for PegasusX Supplier Portal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "sql:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-write-text-file",
    "process:default",
    "process:allow-restart",
    "updater:default"
  ]
}
