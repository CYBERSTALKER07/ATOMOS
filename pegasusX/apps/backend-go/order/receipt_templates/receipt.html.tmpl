<!DOCTYPE html>
<html lang="{{.CountryCode}}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{.CompanyName}} · {{.ReceiptID}}</title>
  <style>
    :root {
      --ink: #0f172a;
      --muted: #475569;
      --line: #d1fae5;
      --bg: #f8fafc;
      --panel: #ffffff;
      --brand: #0b1f17;
      --accent: #059669;
      --accent-soft: #ecfdf5;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
      color: var(--ink);
      background:
        radial-gradient(1200px 600px at 10% -10%, #d1fae5 0%, transparent 55%),
        linear-gradient(180deg, #f0fdf4 0%, var(--bg) 40%, #eef2ff 100%);
      min-height: 100vh;
      padding: 24px 16px 48px;
    }
    .sheet {
      max-width: 720px;
      margin: 0 auto;
      background: var(--panel);
      border: 1px solid var(--line);
      box-shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
      overflow: hidden;
    }
    .mast {
      background: var(--brand);
      color: #e8f5e9;
      padding: 20px 24px;
      display: flex;
      gap: 16px;
      align-items: center;
      justify-content: space-between;
    }
    .mast img { height: 40px; width: auto; display: block; }
    .mast .meta { text-align: right; font-size: 12px; color: #a7f3d0; }
    .body { padding: 24px; }
    h1 {
      font-size: 1.45rem;
      font-weight: 600;
      margin: 0 0 6px;
      letter-spacing: -0.02em;
    }
    .sub { color: var(--muted); margin: 0 0 18px; font-size: 0.95rem; }
    .pill {
      display: inline-block;
      background: var(--accent-soft);
      color: var(--accent);
      border: 1px solid var(--line);
      padding: 4px 10px;
      font-size: 12px;
      margin-bottom: 16px;
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px 18px;
      margin-bottom: 22px;
      font-size: 0.92rem;
    }
    .grid dt { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; margin: 0; }
    .grid dd { margin: 2px 0 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.88rem; word-break: break-all; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      margin: 8px 0 18px;
    }
    th, td { padding: 8px 6px; border-bottom: 1px solid #e2e8f0; text-align: left; }
    th { background: var(--accent-soft); color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; }
    td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
    .total {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 14px 0;
      border-top: 2px solid var(--brand);
      font-size: 1.15rem;
      font-weight: 600;
    }
    .footer {
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px dashed #cbd5e1;
      color: var(--muted);
      font-size: 0.8rem;
      line-height: 1.45;
    }
    .actions { margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap; }
    .actions a {
      color: var(--brand);
      background: var(--accent-soft);
      border: 1px solid var(--line);
      padding: 8px 12px;
      text-decoration: none;
      font-size: 0.85rem;
      font-family: system-ui, sans-serif;
    }
    .verify { margin-top: 10px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; word-break: break-all; }
    @media (max-width: 560px) {
      .grid { grid-template-columns: 1fr; }
      .mast { flex-direction: column; align-items: flex-start; }
      .mast .meta { text-align: left; }
    }
    @media print {
      body { background: #fff; padding: 0; }
      .sheet { box-shadow: none; border: none; }
      .actions { display: none; }
    }
  </style>
</head>
<body>
  <article class="sheet">
    <header class="mast">
      {{if .LogoDataURI}}<img src="{{.LogoDataURI}}" alt="{{.CompanyName}}" />{{else}}<strong>{{.CompanyName}}</strong>{{end}}
      <div class="meta">
        <div>{{.CompanyName}}</div>
        {{if .IssuerTIN}}<div>TIN / STIR · {{.IssuerTIN}}</div>{{end}}
        <div>{{.CountryCode}}</div>
      </div>
    </header>
    <div class="body">
      <div class="pill">{{.PartyLabel}}</div>
      <h1>{{.Title}}</h1>
      <p class="sub">{{.Subtitle}}</p>

      <dl class="grid">
        <div>
          <dt>{{.Layout.Labels.ReceiptID}}</dt>
          <dd>{{.ReceiptID}}</dd>
        </div>
        <div>
          <dt>{{.Layout.Labels.OrderID}}</dt>
          <dd>{{.OrderID}}</dd>
        </div>
        <div>
          <dt>{{.Layout.Labels.IssuedAt}}</dt>
          <dd>{{.IssuedAt.UTC.Format "2006-01-02 15:04 MST"}}</dd>
        </div>
        <div>
          <dt>{{.Layout.Labels.PaymentMethod}}</dt>
          <dd>{{if .PaymentMethod}}{{.PaymentMethod}}{{else}}—{{end}}</dd>
        </div>
        <div>
          <dt>{{.Layout.Labels.Supplier}}</dt>
          <dd>{{if .SupplierID}}{{.SupplierID}}{{else}}—{{end}}</dd>
        </div>
        <div>
          <dt>{{.Layout.Labels.Retailer}}</dt>
          <dd>{{if .RetailerID}}{{.RetailerID}}{{else}}—{{end}}</dd>
        </div>
        <div>
          <dt>{{.Layout.Labels.LegalClass}}</dt>
          <dd>{{.LegalClass}}{{if not .TaxOFD}} · tax_ofd=false{{end}}</dd>
        </div>
        <div>
          <dt>Provider</dt>
          <dd>{{.Provider}}</dd>
        </div>
      </dl>

      <table>
        <thead>
          <tr>
            <th>{{.Layout.Labels.SKU}}</th>
            <th>{{.Layout.Labels.Item}}</th>
            <th class="num">{{.Layout.Labels.Qty}}</th>
            <th class="num">{{.Layout.Labels.UnitPrice}}</th>
            <th class="num">{{.Layout.Labels.LineTotal}}</th>
          </tr>
        </thead>
        <tbody>
          {{range .LineItems}}
          <tr>
            <td>{{.SKU}}</td>
            <td>{{.Name}}</td>
            <td class="num">{{.Quantity}}</td>
            <td class="num">{{money .UnitPriceMinor $.Currency}}</td>
            <td class="num">{{money .LineTotalMinor $.Currency}}</td>
          </tr>
          {{else}}
          <tr><td colspan="5" style="text-align:center;color:#94a3b8">—</td></tr>
          {{end}}
        </tbody>
      </table>

      <div class="total">
        <span>{{.Layout.Labels.Total}}</span>
        <span>{{money .AmountMinor .Currency}}</span>
      </div>

      <div class="actions">
        {{if .PDFURL}}<a href="{{.PDFURL}}">{{.Layout.Labels.DownloadPDF}}</a>{{end}}
        {{if .HTMLURL}}<a href="{{.HTMLURL}}">HTML</a>{{end}}
      </div>

      <div class="footer">
        <p>{{.FooterNote}}</p>
        {{if not .TaxOFD}}<p>{{.TaxOFDNote}}</p>{{end}}
        <p class="verify">{{.Layout.Labels.VerifyQR}}: {{.QRURL}}</p>
      </div>
    </div>
  </article>
</body>
</html>
