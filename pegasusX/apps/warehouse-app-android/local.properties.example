# Copy to local.properties.
# dev.host resolves to BuildConfig.API_BASE_URL in debug builds.
# dev.portal.host resolves to BuildConfig.PORTAL_BASE_URL (warehouse-portal, port 3002).
#   Android emulator (AVD):       dev.host=10.0.2.2
#   Physical device over Wi-Fi:   dev.host=192.168.1.42
dev.host=10.0.2.2
# dev.portal.host=10.0.2.2
