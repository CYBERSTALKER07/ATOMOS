{
  "name": "@pegasusx/admin-portal",
  "private": true,
  "version": "1.0.1",
  "description": "PegasusX platform admin console — tenant lifecycle + feature-flag governance (PLATFORM_ADMIN)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "bash ../../scripts/next_tauri_static_export.sh .",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "TAURI_BUILD=1 tauri build",
    "tauri:build:mac": "TAURI_BUILD=1 tauri build --target universal-apple-darwin",
    "tauri:build:win": "TAURI_BUILD=1 tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:linux": "TAURI_BUILD=1 tauri build --target x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "@pegasusx/types": "workspace:*",
    "@pegasusx/ui-kit": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "next": "^15.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
