{
  "name": "@pegasusx/warehouse-portal",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3002",
    "build": "next build",
    "build:static": "bash ../../scripts/next_tauri_static_export.sh .",
    "start": "next start -p 3002",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "TAURI_BUILD=1 tauri build",
    "tauri:build:mac": "TAURI_BUILD=1 tauri build --target universal-apple-darwin",
    "tauri:build:win": "TAURI_BUILD=1 tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:debug": "TAURI_BUILD=1 tauri build --debug",
    "tauri:build:store": "NEXT_PUBLIC_DESKTOP_DISTRIBUTION=store TAURI_BUILD=1 tauri build --config src-tauri/tauri.store.conf.json",
    "tauri:build:store:win": "NEXT_PUBLIC_DESKTOP_DISTRIBUTION=store TAURI_BUILD=1 tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.microsoftstore.conf.json",
    "tauri:build:store:mac": "NEXT_PUBLIC_DESKTOP_DISTRIBUTION=store TAURI_BUILD=1 tauri build --target universal-apple-darwin --config src-tauri/tauri.macappstore.conf.json",
    "tauri:build:enterprise:win": "NEXT_PUBLIC_DESKTOP_DISTRIBUTION=enterprise TAURI_BUILD=1 tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:enterprise:mac": "NEXT_PUBLIC_DESKTOP_DISTRIBUTION=enterprise TAURI_BUILD=1 tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@pegasusx/api-client": "workspace:*",
    "@pegasusx/desktop-bridge": "workspace:*",
    "@pegasusx/desktop-cache": "workspace:*",
    "@pegasusx/explain-ui": "workspace:*",
    "@pegasusx/i18n": "workspace:*",
    "@pegasusx/pulse-ui": "workspace:*",
    "@pegasusx/types": "workspace:*",
    "@pegasusx/ui-kit": "workspace:*",
    "@pegasusx/ws-refresh-contract": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "firebase": "^12.12.0",
    "framer-motion": "^12.40.0",
    "h3-js": "^4.5.0",
    "lucide-react": "^1.7.0",
    "maplibre-gl": "^5.19.0",
    "motion": "^12.38.0",
    "next": "^15.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-map-gl": "^8.1.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
