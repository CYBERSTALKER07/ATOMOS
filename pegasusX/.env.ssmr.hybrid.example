# pegasusX hybrid SSMR — local Docker core + free/near-free cloud APIs
#
# Copy on top of .env.ssmr (or merge into your active .env):
#   cp .env.ssmr.example .env.ssmr
#   cat .env.ssmr.hybrid.example >> .env.ssmr
#
# Keeps Spanner emulator, Redis, Kafka, OSRM, and Global Pay dev sim in Docker.
# Adds real cloud APIs where free tier improves fidelity without staging spend.
#
# Full inventory: docs/CLOUD_CREDENTIALS_CHECKLIST.md
# Paid core (defer until staging): Cloud Spanner, Memorystore, managed Kafka, GKE.

# =============================================================================
# PHASE 1 — connect first (free or generous dev credit)
# =============================================================================

# --- 1a. Firebase Auth + FCM (Spark plan: $0 at dev scale) ---
# Backend: verify retailer/driver/factory/warehouse/payload bearer tokens.
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-adminsdk.json
# Optional: point backend at Auth emulator while clients use real project config
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# SSMR e2e optional markers (mint test ID tokens from Firebase console or emulator):
# DRIVER_FIREBASE_TEST_ID_TOKEN=
# FACTORY_FIREBASE_TEST_ID_TOKEN=
# PAYLOAD_FIREBASE_TEST_ID_TOKEN=
# RETAILER_FIREBASE_TEST_ID_TOKEN=

# Portals (factory + warehouse) — same project, Auth emulator in dev:
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://localhost:9099

# --- 1b. Google Maps Platform ($200/mo Maps credit — dev usage stays in credit) ---
# Backend geocoding for topology / factory / warehouse location pickers.
# Enable: Geocoding API (+ Places if autocomplete needed). NOT Maps JS API.
GOOGLE_MAPS_API_KEY=your-maps-platform-key

# Android Maps SDK (driver + retailer apps) — same GCP project key, restrict by package.
# MAPS_API_KEY in android local.properties or BuildConfig.

# =============================================================================
# PHASE 2 — optional hybrid (still mostly free tier)
# =============================================================================

# --- 2a. GCS (5 GB standard free tier) ---
# Catalog signed uploads + import CSV when not using IMPORT_LOCAL_FILE_ROOT.
# GCS_BUCKET_NAME=your-pegasusx-dev-bucket
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcs-writer-sa.json

# --- 2b. Global Pay.UZ staging (merchant test account — not GCP) ---
# More accurate than WireMock dev sim; keep GLOBAL_PAY_ENV=staging.
# GLOBAL_PAY_ENV=staging
# GLOBAL_PAY_SERVICE_ID=
# GLOBAL_PAY_USERNAME=
# GLOBAL_PAY_PASSWORD=
# GLOBAL_PAY_WEBHOOK_SECRET=
# GLOBAL_PAY_BASE_URL=https://checkout-api.globalpay.uz

# =============================================================================
# PHASE 3 — defer (paid managed infra; use cloud_smoke_ssmr.sh against staging)
# =============================================================================
# Cloud Spanner (~$650+/mo)     → keep SPANNER_EMULATOR_HOST for local
# Memorystore Redis (~$35+/mo)  → keep REDIS_ADDR=localhost:6389
# Managed Kafka (~$120+/mo)     → keep KAFKA_BROKERS=localhost:9094
# GKE Autopilot (~$180+/mo)     → docker-compose.ssmr.yml backend-go
# Confluent trial               → optional if testing consumer lag at scale only
