{
  "name": "pegasusx",
  "private": true,
  "version": "0.1.0",
  "description": "Single-supplier logistics stack. Sibling project to pegasus.",
  "workspaces": [
    "apps/supplier-portal",
    "apps/admin-portal",
    "apps/retailer-app-desktop",
    "apps/warehouse-portal",
    "apps/factory-portal",
    "apps/payload-terminal",
    "packages/types",
    "packages/api-core",
    "packages/api-react",
    "packages/validation",
    "packages/i18n",
    "packages/motion-tokens",
    "packages/ui-kit",
    "packages/pulse-ui",
    "packages/explain-ui",
    "packages/ws-refresh-contract",
    "packages/desktop-bridge",
    "packages/desktop-cache",
    "packages/ui-maps",
    "packages/ui-charts"
  ],
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "verify:fast": "pnpm -r --if-present typecheck && pnpm -r --if-present test && bash scripts/validate_spanner_stale_reads.sh && python3 scripts/validate_launch_readiness.py",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:sandbox:up": "docker compose -f infra/docker-compose.sandbox.yml up -d",
    "infra:sandbox:down": "docker compose -f infra/docker-compose.sandbox.yml down",
    "infra:sandbox:test": "bash scripts/smoke_sandbox.sh",
    "test:sandbox": "bash scripts/smoke_sandbox.sh",
    "test:sandbox:lifecycle": "bash scripts/smoke_sandbox_lifecycle.sh",
    "infra:ssmr:up": "docker compose -f infra/docker-compose.ssmr.yml up -d",
    "infra:ssmr:down": "docker compose -f infra/docker-compose.ssmr.yml down",
    "infra:ssmr:test": "bash scripts/smoke_ssmr.sh",
    "test:ssmr": "bash scripts/smoke_ssmr.sh",
    "test:ssmr:lifecycle": "bash scripts/smoke_ssmr_lifecycle.sh",
    "infra:k8s:validate": "bash scripts/validate_ai_worker_k8s.sh",
    "infra:launch:validate": "python3 scripts/validate_launch_readiness.py",
    "infra:load:cert": "bash scripts/load/load_cert.sh",
    "infra:load:cert:ssmr": "bash scripts/load/load_cert.sh --with-ssmr"
  },
  "pnpm": {
    "overrides": {
      "next@^15.0.0": "^15.5.29",
      "postcss@^8.0.0": "^8.5.33",
      "sharp@^0.34.0": "^0.35.5",
      "source-map-js@^1.0.0": "^1.2.2",
      "nanoid@^3.0.0": "^3.3.20",
      "fast-xml-parser@^5.0.0": "^5.12.1",
      "@grpc/grpc-js@^1.0.0": "^1.14.7",
      "websocket-driver@^0.7.0": "^0.8.0",
      "body-parser@^2.0.0": "^2.4.0",
      "shell-quote@^1.0.0": "^1.12.0",
      "ws@^7.0.0": "^7.5.11",
      "ws@^8.0.0": "^8.23.0",
      "js-yaml@^3.0.0": "^3.15.2",
      "js-yaml@^4.0.0": "^4.3.2",
      "brace-expansion@^1.0.0": "^1.1.20",
      "brace-expansion@^5.0.0": "^5.0.13",
      "@xmldom/xmldom@^0.8.0": "^0.8.15",
      "@xmldom/xmldom@^0.9.0": "^0.9.12",
      "browserslist@^4.0.0": "^4.29.6",
      "compression@^1.0.0": "^1.8.2",
      "image-size@^2.0.0": "^2.1.0",
      "joi@^17.0.0": "^17.13.9",
      "zod@^4.0.0": "^4.6.7",
      "node-forge@^1.0.0": "^1.4.3",
      "maplibre-gl": "^6.19.0"
    }
  }
}
