new file mode 100644
index 000000000..37ca167ac
--- /dev/null
+++ b/pegasusX/apps/backend-go/schema/migrations/20260720_order_fiscal_receipts.ddl
@@ -0,0 +1,46 @@
+-- ADR-009 Fiscal hard-gate: immutable fiscal attempts + denormalized order status.
+-- Additive only. Apply via backend-setup / phase0 migrate.
+-- Order status graph is enforced in Go (order/state_machine.go), not CHK on Orders.Status.
+-- After apply: add StatusFiscalizing / StatusFiscalFailed constants + SM edges.
+-- Attempt Status values: PENDING | SUCCESS | FAILED | FORCE_SKIPPED (app-enforced).
+-- Amounts: integer Tiyin (AmountMinor INT64). Currency UZS.
+
+-- Receipts are supplier-scoped (§9.2). Today 1 order = 1 supplier ⇒ one leg = order total.
+-- Multi-supplier later: multiple rows per OrderId; order FiscalStatus is the rollup.
+CREATE TABLE OrderFiscalReceipts (
+  OrderId              STRING(36)  NOT NULL,
+  AttemptId            STRING(36)  NOT NULL,
+  SupplierId           STRING(36)  NOT NULL,   -- fiscal leg owner (per-supplier receipt)
+  RetailerId           STRING(36),
+  Provider             STRING(32)  NOT NULL,   -- MY_SOLIQ | OFD | FAKE
+  Status               STRING(32)  NOT NULL,   -- PENDING | SUCCESS | FAILED | FORCE_SKIPPED
+  FiscalReceiptId      STRING(128),
+  FiscalQR             STRING(MAX),
+  AmountMinor          INT64       NOT NULL,   -- leg amount (Tiyin); single-supplier = order total
+  Currency             STRING(8)   NOT NULL,
+  PaymentMethod        STRING(16),            -- CASH | CARD (money received — never unpaid credit)
+  ProviderPayloadJSON  BYTES(MAX),            -- redact secrets at write
+  ErrorCode            STRING(64),
+  ErrorMessage         STRING(1024),
+  ReasonCode           STRING(64),            -- force-complete reason when FORCE_SKIPPED
+  ActorId              STRING(128),           -- force actor (ADMIN | WAREHOUSE_ADMIN)
+  TraceId              STRING(64),
+  CreatedAt            TIMESTAMP   NOT NULL OPTIONS (allow_commit_timestamp=true),
+  UpdatedAt            TIMESTAMP   NOT NULL OPTIONS (allow_commit_timestamp=true),
+) PRIMARY KEY (OrderId, AttemptId);
+
+CREATE INDEX Idx_OrderFiscalReceipts_ByStatusCreated
+  ON OrderFiscalReceipts(Status, CreatedAt DESC);
+
+CREATE INDEX Idx_OrderFiscalReceipts_ByReceiptId
+  ON OrderFiscalReceipts(FiscalReceiptId);
+
+CREATE INDEX Idx_OrderFiscalReceipts_BySupplier
+  ON OrderFiscalReceipts(SupplierId, CreatedAt DESC);
+
+-- Fast list/filter for tracking and treasury.
+-- FiscalStatus app values: NONE | PENDING | SUCCESS | FAILED | FORCE_SKIPPED
+ALTER TABLE Orders ADD COLUMN FiscalStatus STRING(32);
+ALTER TABLE Orders ADD COLUMN LatestFiscalReceiptId STRING(128);
+ALTER TABLE Orders ADD COLUMN FiscalizedAt TIMESTAMP;
+ALTER TABLE Orders ADD COLUMN LatestFiscalAttemptId STRING(36);
