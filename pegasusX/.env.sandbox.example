# pegasusX sandbox environment example
# Used by infra/docker-compose.sandbox.yml for the isolated integration stack.
# PEGASUSX_ENV=ssmr remains a one-release alias (auth.IsSandbox).

# --- Compose isolation ---
COMPOSE_PROJECT_NAME=pegasusx-sandbox

# --- Feature flags ---
# Pull-matrix / look-ahead engines. Go default remains false when unset.
FACTORY_PLANNING_ENABLED=true
FACTORY_BATCHER_ENABLED=true
ALLOCATION_REQUIRED=false
CONSTRAINED_ALLOCATION_ENABLED=false
# §8.7 Wave 1A bins/lots/FEFO (apply 20260806_wms_locations_lots.ddl first)
WMS_LOTS_ENABLED=false
WMS_PICK_WAVES_ENABLED=false
WMS_CYCLE_COUNTS_ENABLED=false
WMS_PICK_SSHAPE_ENABLED=false
WMS_SEAL_SOFT_WARN=false
WMS_COLD_CHAIN_ENABLED=false
PAYLOAD_LOAD_LEDGER_ENABLED=false
LABOR_CAPACITY_ENFORCE=false
CONTROL_TOWER_PLAYBOOKS_ENABLED=false
CONTROL_TOWER_PLAYBOOKS_AUTO_EXECUTE=false
# Collections substance (e2e: PX_E2E_COLLECTIONS_DUNNING_OK when both true)
AR_INVOICES_ENABLED=true
AR_DUNNING_ENABLED=true
# §8.4 forecast accuracy (e2e: PX_E2E_FORECAST_ACCURACY_OK)
FORECAST_ACCURACY_ENABLED=true
# §8.1 Croston/SES/HW (e2e: PX_E2E_FORECAST_ALGO_OK)
FORECAST_ALGO_ENABLED=true
FORECAST_ALGO_REQUIRE_GATE=false
# Theatre #8 YoY calendar drafts (optional; soft-skip when off)
# FORECAST_SEASONAL_ESTIMATE_ENABLED=true
# §8.2 service-level safety stock (e2e: PX_E2E_SAFETY_STOCK_OK / PX_E2E_SAFETY_STOCK_REPLAY_OK)
SAFETY_STOCK_V2_ENABLED=true
SAFETY_STOCK_REPLAY_REQUIRE_GATE=false
# §8.3 inventory-grounded auto-order (e2e: PX_E2E_AUTO_ORDER_SHADOW_OK)
AUTO_ORDER_SHADOW_ENABLED=true
AUTO_ORDER_INVENTORY_GROUNDED=true
AUTO_ORDER_PLACE_ENABLED=false

# --- HTTP ---
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8180

# --- Spanner (isolated emulator defaults) ---
SPANNER_EMULATOR_HOST=localhost:9110
SPANNER_PROJECT=pegasusx-ssmr-local
SPANNER_INSTANCE=pegasusx-ssmr-instance
SPANNER_DATABASE=pegasusx-ssmr-db

# --- Redis ---
REDIS_ADDR=localhost:6389

# --- Kafka ---
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC_MAIN=ssmr.events.orders
# KAFKA_TOPIC_SPATIAL removed — no backend consumer until product owns spatial stream.
KAFKA_TOPIC_REALTIME=ssmr.events.realtime
KAFKA_TOPIC_WEBHOOKS=ssmr.events.webhooks
KAFKA_TOPIC_FREEZE_LOCKS=pegasusx-freeze-locks
KAFKA_TOPIC_INVENTORY_IMPORT=ssmr.events.inventory-import

# --- Import async worker (SSMR local object root; host path mirrors ai-worker mount) ---
IMPORT_LOCAL_FILE_ROOT=/data/import-uploads
SSMR_IMPORT_LOCAL_ROOT=.ssmr/import-uploads

# --- Partner Integration Wave 2A/2B (export + optional SFTP + EDI-lite) ---
PARTNER_EXPORTS_ENABLED=true
PARTNER_EXPORT_LOCAL_ROOT=.ssmr/partner-exports
PARTNER_SFTP_ENABLED=true
PARTNER_EDI_ENABLED=true
PARTNER_EDI_LOCAL_ROOT=.ssmr/partner-edi
PARTNER_AS2_ENABLED=true
PARTNER_AS2_INSECURE_PLAIN=true
PARTNER_SFTP_STRICT_HOSTKEY=false
# Webhook SSRF: SSMR uses host.docker.internal + http httptest receivers
PARTNER_WEBHOOK_ALLOW_HTTP=true
PARTNER_WEBHOOK_ALLOW_PRIVATE=true
# Set both true in SSMR to exercise PX_E2E_PARTNER_AS2_* markers
# PARTNER_AS2_ENABLED=true
# PARTNER_AS2_INSECURE_PLAIN=true
# Dev secret material for PartnerSftpConfigs.SecretRef (e.g. SecretRef=demo → PARTNER_SFTP_SECRET_DEMO)
# PARTNER_SFTP_SECRET_DEMO=

# --- Phase 4 autonomy evidence (shadow soak; place stays off) ---
FORECAST_ALGO_ENABLED=true
FORECAST_ACCURACY_ENABLED=true
SAFETY_STOCK_V2_ENABLED=true
AUTO_ORDER_WORKER_ENABLED=true
AUTO_ORDER_SHADOW_ENABLED=true
AUTO_ORDER_PLACE_ENABLED=false
PARTIAL_ALLOCATION_ENABLED=true
WMS_PICK_WAVES_ENABLED=true
WMS_CYCLE_COUNTS_ENABLED=true

# --- GS1 labels Wave 2C (SSCC at seal + ZPL) ---
GS1_LABELS_ENABLED=true
GS1_COMPANY_PREFIX=0614141


# --- Auth ---
JWT_SECRET=dev-only-change-me
# PARTNER_JWT_SECRET=
JWT_ISSUER=pegasusx-ssmr-dev

# --- Firebase Auth (portal phone OTP in local dev) ---
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=demo-pegasus
# Host-side emulator; backend container uses host.docker.internal (see docker-compose.ssmr.yml)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_CERTS_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com

# --- Fiscal / OFD (G1.B) ---
# SSMR is non tax-class: commercial PEGASUS is fine for local smoke (tax_ofd=false).
# Tax-market cutover: set MY_SOLIQ + creds + signer (or FISCAL_TAX_MARKET=true with full Soliq env).
FISCAL_PROVIDER=PEGASUS
# FISCAL_PROVIDER=MY_SOLIQ
# FISCAL_TAX_MARKET=true
# FISCAL_MY_SOLIQ_BASE_URL=
# FISCAL_MY_SOLIQ_API_KEY=
# FISCAL_MY_SOLIQ_TIN=
# EDS signer (required when FISCAL_PROVIDER=MY_SOLIQ):
#   dev-hmac  non-prod contract tests/SSMR; needs FISCAL_MY_SOLIQ_SIGN_KEY
#   pkcs12    real E-IMZO container; needs FISCAL_MY_SOLIQ_PKCS12_FILE + _PASSWORD
# FISCAL_MY_SOLIQ_SIGNER=dev-hmac
# FISCAL_MY_SOLIQ_SIGN_KEY=
# FISCAL_MY_SOLIQ_PKCS12_FILE=
# FISCAL_MY_SOLIQ_PKCS12_PASSWORD=

# --- Global Pay.UZ (dev simulator — matches production checkout flow locally) ---
GLOBAL_PAY_ENV=dev
GLOBAL_PAY_SERVICE_ID=ssmr-supplier-service
GLOBAL_PAY_USERNAME=ssmr-globalpay-user
GLOBAL_PAY_PASSWORD=ssmr-globalpay-pass

# --- Webhook signature secrets (dev defaults; allowed in SSMR — NOT in production) ---
# Production cutover: set PEGASUSX_ENV=production and non-dev-* secrets or bootstrap refuses start.
GLOBAL_PAY_WEBHOOK_SECRET=dev-global-pay-secret
ADYEN_WEBHOOK_SECRET=dev-adyen-secret
STRIPE_WEBHOOK_SECRET=dev-stripe-secret
PAYME_WEBHOOK_SECRET=dev-payme-secret
CLICK_WEBHOOK_SECRET=dev-click-secret

# --- Optimizer + internal auth (OR-Tools sidecar in compose; ai-worker for Kafka/import) ---
OPTIMIZER_BASE_URL=http://localhost:8182
INTERNAL_API_KEY=dev-internal-key

# Feature flag: when false, AIRWALLEX checkout execution is policy-blocked.
AIRWALLEX_DIRECT_EXECUTION_ENABLED=false

# --- Single tenant seed ---
SEED_SUPPLIER_NAME=SSMR Supplier
SEED_SUPPLIER_COUNTRY=UZ
SEED_SUPPLIER_CURRENCY=UZS

# --- Spatial perimeter bootstrap ---
DELIVERY_ZONE_CENTER_LAT=41.2995
DELIVERY_ZONE_CENTER_LNG=69.2401
DELIVERY_ZONE_RADIUS_KM=20
DELIVERY_ZONE_RESOLUTION=9

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Reliability strict mode ---
REQUIRE_INFRA_ADAPTERS=true
RELIABILITY_MIDDLEWARE_ENABLED=true
# Raised for local k6 / load-cert (per-actor operational class; /v1/health is always exempt)
RELIABILITY_RATE_LIMIT_DEFAULT_MAX=12000
# Auth register/login burst during loadtokens (64+ retailers) shares host ip:* bucket
RELIABILITY_RATE_LIMIT_AUTH_MAX=12000
RELIABILITY_PRIORITY_MAX_IN_FLIGHT=256
# load_cert / loadtokens send X-PegasusX-Load-Bootstrap — exempts /v1/auth/* from rate limit (SSMR only)
LOAD_BOOTSTRAP_SECRET=pegasusx-ssmr-load-bootstrap
# Distinct retailer JWTs for k6 cert (see scripts/load/load_cert.sh)
# LOAD_RETAILER_POOL_SIZE=64

# --- Shop-closed protocol (PX9) ---
SHOP_CLOSED_GRACE_MINUTES=5
# ALLOW_DRIVER_DEMO_FALLBACK=true

# --- Geolocation (optional; Nominatim fallback when unset in SSMR) ---
# Staging/prod: set via GSM secret pegasusx-<tenant>-google-maps-api-key
# Enable APIs: Geocoding API, Places API (Autocomplete + Details), Maps SDK for Android only.
# GOOGLE_MAPS_API_KEY=

# --- Multi-supplier (Gate 5 Phase 2: dynamic ecosystem + ParentOrders) ---
MAX_SUPPLIERS=10
ALLOW_MULTI_SUPPLIER_REGISTER=true
# Gate 5 Phase 2: ParentOrders split checkout (default-on via PEGASUSX_ENV=sandbox).
PEGASUSX_ENV=sandbox
MULTI_SUPPLIER_CHECKOUT_ENABLED=true
ALLOW_SEED_FALLBACK=false
# Gate 5 / §8.10 Phase 3: GlobalProducts master + match worker
GLOBAL_PRODUCTS_ENABLED=true
TENANT_CONTEXT_ENFORCED=true
TENANT_RATE_LIMIT_SHARED=true
OUTBOX_SUPPLIER_BACKFILL=true

# --- Sandbox smoke identities (e2e flow). SSMR_* aliases still accepted. ---
SANDBOX_SMOKE_SUPPLIER_PHONE=+998901000001
SANDBOX_SMOKE_SUPPLIER_PASSWORD=SmokeTest!234
SANDBOX_SMOKE_SUPPLIER_ID=sup_61d822c6ab9714ca11f20db9
SANDBOX_SMOKE_RETAILER_PHONE=+998901000099
SANDBOX_SMOKE_DRIVER_ID=ssmr-driver-1
SANDBOX_SMOKE_WAREHOUSE_ID=ssmr-warehouse-1
SSMR_SMOKE_SUPPLIER_PHONE=+998901000001
SSMR_SMOKE_SUPPLIER_PASSWORD=SmokeTest!234
SSMR_SMOKE_SUPPLIER_ID=sup_61d822c6ab9714ca11f20db9
SSMR_SMOKE_RETAILER_PHONE=+998901000099
SSMR_SMOKE_DRIVER_ID=ssmr-driver-1
SSMR_SMOKE_WAREHOUSE_ID=ssmr-warehouse-1
WAREHOUSE_DEMO_ID=ssmr-warehouse-1
FACTORY_DEMO_ID=factory-demo-1
FACTORY_DEMO_PHONE=+998901000099
FACTORY_DEMO_PIN=1234
DRIVER_DEMO_PHONE=+998901000066
DRIVER_DEMO_PIN=1234
DRIVER_DEMO_ID=ssmr-driver-1
DRIVER_DEMO_HOME_NODE_ID=ssmr-warehouse-1
DRIVER_DEMO_HOME_NODE_TYPE=WAREHOUSE
PAYLOAD_DEMO_WAREHOUSE_ID=ssmr-warehouse-1

# Portal/role demo seeds — OFF for prod-ready SSMR (empty API → empty UI).
# Set true only for local scaffold without Spanner data.
FACTORY_PORTAL_SEED=false
WAREHOUSE_PORTAL_SEED=false
PAYLOAD_PORTAL_SEED=false
USE_DEMO_SEED=false
ALLOW_DRIVER_DEMO_FALLBACK=false

# --- Global Pay mock (WireMock on host 8185 when compose profile includes globalpay-mock) ---
GLOBAL_PAY_BASE_URL=http://localhost:8185