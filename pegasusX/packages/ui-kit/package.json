{
  "name": "@pegasusx/ui-kit",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "./styles/*.css"
  ],
  "exports": {
    "./styles/desktop-foundation.css": {
      "style": "./styles/desktop-foundation.css",
      "default": "./styles/desktop-foundation.css"
    },
    "./styles/auth-layout.css": {
      "style": "./styles/auth-layout.css",
      "default": "./styles/auth-layout.css"
    },
    "./styles/auth-desktop.css": {
      "style": "./styles/auth-desktop.css",
      "default": "./styles/auth-desktop.css"
    },
    "./styles/portal-ui.css": {
      "style": "./styles/portal-ui.css",
      "default": "./styles/portal-ui.css"
    },
    "./styles/setup-onboarding.css": {
      "style": "./styles/setup-onboarding.css",
      "default": "./styles/setup-onboarding.css"
    },
    "./styles/monochrome-desktop.css": {
      "style": "./styles/monochrome-desktop.css",
      "default": "./styles/monochrome-desktop.css"
    },
    ".": "./src/index.ts",
    "./portal": "./src/portal/index.ts",
    "./auth": "./src/auth/index.ts",
    "./pack": "./src/pack/index.ts",
    "./control-tower": "./src/control-tower/index.ts",
    "./desktop": "./src/desktop/index.ts",
    "./tailwind.config": "./tailwind.config.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "react": "19.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@pegasusx/api-core": "workspace:*",
    "@pegasusx/api-react": "workspace:*",
    "@pegasusx/types": "workspace:*",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "react-virtuoso": "^4.12.5"
  }
}