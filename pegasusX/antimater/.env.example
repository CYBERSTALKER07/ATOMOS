# ==============================================================================
# PEGASUS LOGISTICS OS: ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase (Enterprise Requests, Subscriptions & Audit Logs)
# Run `supabase/schema.sql` in your Supabase SQL Editor to initialize tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# xAI (Grok) — Site AI Assistant
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Email Delivery & Notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pegasus Enterprise <onboarding@resend.dev>
RECIPIENT_EMAIL=hello@pegasus.io

# Deployment URL
NEXT_PUBLIC_SITE_URL=https://pegasus.io
