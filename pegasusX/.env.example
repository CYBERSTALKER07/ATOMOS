# pegasusX environment example
# Copy to .env and fill in. Never commit secrets.

# --- Global Pay.UZ (primary payment rail — Boss provides production credentials) ---
GLOBAL_PAY_ENV=dev
# GLOBAL_PAY_SERVICE_ID=
# GLOBAL_PAY_USERNAME=
# GLOBAL_PAY_PASSWORD=

# --- WebSocket CORS (comma-separated portal origins in production) ---
# WS_ALLOWED_ORIGINS=https://supplier.example.com,https://warehouse.example.com

# --- GCS (supplier catalog images + CSV import; required for prod catalog) ---
# GCS_BUCKET_NAME=your-prod-catalog-bucket
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# --- Internal service auth (ai-worker optimizer) ---
# INTERNAL_API_KEY=

# --- Kafka freeze locks (ai-worker consumer) ---
# KAFKA_TOPIC_FREEZE_LOCKS=pegasusx-freeze-locks

# --- Feature flags ---
# FACTORY_PLANNING_ENABLED=true runs pull-matrix / look-ahead engines (creates SYSTEM_THRESHOLD transfers).
# FACTORY_BATCHER_ENABLED=true uses FFD+NN+LIFO on POST /v1/factory/dispatch (still no invent-if-empty).
# Go defaults remain false when these env vars are unset (CI).
FACTORY_PLANNING_ENABLED=true
FACTORY_BATCHER_ENABLED=true
# ALLOCATION_REQUIRED=false keeps legacy single-warehouse reservation at order create.
# ALLOCATION_REQUIRED=true defers reservation and runs multi-warehouse allocation before dispatch.
ALLOCATION_REQUIRED=false
# WMS_LOTS_ENABLED=false keeps bag-of-SKU SupplierInventoryV2 reserve/credit.
# WMS_LOTS_ENABLED=true enables §8.7 Wave 1A bins + StockLots + FEFO allocation (+ V2 roll-up).
WMS_LOTS_ENABLED=false
# WMS_PICK_WAVES_ENABLED=true enables §8.7 Wave 1B PickWaves/PickTasks + hard seal gate.
WMS_PICK_WAVES_ENABLED=false
# WMS_CYCLE_COUNTS_ENABLED=true enables §8.7 Wave 1C/PR-4 cycle counts + apply-on-approve.
WMS_CYCLE_COUNTS_ENABLED=false
# WMS_PICK_SSHAPE_ENABLED=true enables zone serpentine + LIFO pick sequencing (PR-5).
WMS_PICK_SSHAPE_ENABLED=false
# WMS_SEAL_SOFT_WARN=true seals with pick_wave_warning instead of hard 409 (PR-5).
WMS_SEAL_SOFT_WARN=false
# WMS_COLD_CHAIN_ENABLED=true enables temperature ingest + lot quarantine (PR-6).
WMS_COLD_CHAIN_ENABLED=false
# PAYLOAD_LOAD_LEDGER_ENABLED=true enforces line-level scan ledger before seal (G2.B).
PAYLOAD_LOAD_LEDGER_ENABLED=false
# LABOR_CAPACITY_ENFORCE=true hard-refuses dispatch when ZoneCapacity overloaded (G2.C).
LABOR_CAPACITY_ENFORCE=false
# CONSTRAINED_ALLOCATION_ENABLED=false keeps per-SKU first-fit allocation.
# CONSTRAINED_ALLOCATION_ENABLED=true picks one warehouse via segment/SKU policy scoring.
CONSTRAINED_ALLOCATION_ENABLED=false
# CONTROL_TOWER_PLAYBOOKS_ENABLED=false keeps exception lists manual-only (no playbook engine).
CONTROL_TOWER_PLAYBOOKS_ENABLED=false
# CONTROL_TOWER_PLAYBOOKS_AUTO_EXECUTE=false requires human Approve even when playbook AutoExecute=true.
CONTROL_TOWER_PLAYBOOKS_AUTO_EXECUTE=false
# MEIO_ECHELON_TARGETS_ENABLED=false keeps MEIO network summary without EchelonTargets writes.
MEIO_ECHELON_TARGETS_ENABLED=false
# TWIN_SCENARIO_ENABLED=false keeps planning scenario on heuristic path.
TWIN_SCENARIO_ENABLED=false
# CASH_RECONCILIATION_REQUIRED=false allows shift-end without driver cash reconciliation.
CASH_RECONCILIATION_REQUIRED=false
# CREDIT_NOTE_AUTO_FROM_BUYER_REJECT=false keeps buyer EHF rejection manual-only.
CREDIT_NOTE_AUTO_FROM_BUYER_REJECT=false
# CREDIT_NOTE_AUTO_FROM_CLAIM=false keeps claim approval without auto credit note.
CREDIT_NOTE_AUTO_FROM_CLAIM=false
# CREDIT_SCORE_ENFORCEMENT_ENABLED=false keeps shop-closed/credit-leave paths suggestion-only.
CREDIT_SCORE_ENFORCEMENT_ENABLED=false

# --- HTTP ---
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# --- Spanner (emulator by default) ---
SPANNER_EMULATOR_HOST=localhost:9010
SPANNER_PROJECT=pegasusx-local
SPANNER_INSTANCE=pegasusx-instance
SPANNER_DATABASE=pegasusx-db
# After `go run ./apps/backend-go/cmd/setup`, seed prod-sim smoke rows (vet-queue order + ledger):
#   cd apps/backend-go && go run ./cmd/seed-supplier-prodsim

# --- Redis ---
REDIS_ADDR=localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_MAIN=pegasusx-main

# --- Fiscal / OFD (ADR-009) ---
# FISCAL_PROVIDER=MY_SOLIQ|PEGASUS|FAKE|GLOBAL_PAY
# G1.B product truth:
#   - production/staging (or FISCAL_TAX_MARKET=true): unset defaults to MY_SOLIQ (tax OFD; fail-closed without creds).
#   - local/ssmr: unset defaults to PEGASUS commercial receipts (tax_ofd=false).
#   - PEGASUS is commercial-only — set explicitly; in production also set FISCAL_ALLOW_COMMERCIAL_RECEIPTS=true.
# Local default stays commercial so dev is not blocked without Soliq:
FISCAL_PROVIDER=PEGASUS

# --- FCM / push (G1.D) ---
# production/staging: Firebase required unless FCM_ALLOW_NOOP=true (explicit push_degraded).
# local/ssmr: no-op allowed by default.
# FIREBASE_PROJECT_ID=
# FIREBASE_CREDENTIALS_PATH=
# FCM_ALLOW_NOOP=true
# Tax-market cutover (staging/prod with Soliq):
# FISCAL_PROVIDER=MY_SOLIQ
# FISCAL_TAX_MARKET=true
# FISCAL_MY_SOLIQ_BASE_URL=
# FISCAL_MY_SOLIQ_API_KEY=
# FISCAL_MY_SOLIQ_TIN=
# FISCAL_MY_SOLIQ_PATH=/v1/receipts
# FISCAL_MY_SOLIQ_TIMEOUT_MS=8000
# FISCAL_MY_SOLIQ_SIGNER=pkcs12
# FISCAL_MY_SOLIQ_PKCS12_FILE=
# FISCAL_MY_SOLIQ_PKCS12_PASSWORD=
# PEGASUS_COMPANY_NAME=PegasusX
# PEGASUS_ISSUER_TIN=
# FISCAL_ALLOW_COMMERCIAL_RECEIPTS=true
# FISCAL_GLOBAL_PAY_RECEIPT_ENABLED=false
# FISCAL_GLOBAL_PAY_RECEIPT_BASE_URL=
# FISCAL_GLOBAL_PAY_RECEIPT_API_KEY=

# --- Demo seed (never enable in staging/prod) ---
# USE_DEMO_SEED=false
# FACTORY_PORTAL_SEED=false

# --- Auth ---
JWT_SECRET=dev-only-change-me
# Optional dedicated secret for partner OAuth access tokens (else derived from JWT_SECRET)
# PARTNER_JWT_SECRET=
# PARTNER_JWT_ISSUER=pegasusx-partner
# PARTNER_OAUTH_TTL_SECONDS=900
JWT_ISSUER=pegasusx-dev

# --- Firebase Auth (optional, bearer token verification) ---
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CERTS_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com

# --- Webhook signature secrets (dev defaults in bootstrap if unset) ---
GLOBAL_PAY_WEBHOOK_SECRET=dev-global-pay-secret
ADYEN_WEBHOOK_SECRET=dev-adyen-secret
STRIPE_WEBHOOK_SECRET=dev-stripe-secret
PAYME_WEBHOOK_SECRET=dev-payme-secret
CLICK_WEBHOOK_SECRET=dev-click-secret

# Feature flag: when false, AIRWALLEX checkout execution is policy-blocked.
AIRWALLEX_DIRECT_EXECUTION_ENABLED=false

# --- Multi-supplier (Gate 5 Phase 1: registration frozen until tenancy proven) ---
# Gate 5 Phase 1 freeze default; Phase 2 dynamic ecosystem sets ALLOW_MULTI_SUPPLIER_REGISTER=true + MAX_SUPPLIERS in SSMR.
MAX_SUPPLIERS=1
ALLOW_MULTI_SUPPLIER_REGISTER=false
# MULTI_SUPPLIER_CHECKOUT_ENABLED=false
# Gate 5 / §8.10 Phase 3: GlobalProducts master (default off; SSMR sets true)
# GLOBAL_PRODUCTS_ENABLED=false
# Fail-closed tenant middleware (default on when PEGASUSX_ENV=ssmr|production)
TENANT_CONTEXT_ENFORCED=false
TENANT_RATE_LIMIT_SHARED=true
# Outbox SupplierId backfill worker (default on for ssmr|production)
# OUTBOX_SUPPLIER_BACKFILL=true
# OUTBOX_SUPPLIER_BACKFILL_LIMIT=200
# OUTBOX_SUPPLIER_BACKFILL_INTERVAL=5m

# --- Single tenant seed ---
SEED_SUPPLIER_NAME=pegasusX Supplier
SEED_SUPPLIER_COUNTRY=UZ
SEED_SUPPLIER_CURRENCY=UZS

# --- Order currency picker (theatre #13 Wave 2+; default off) ---
# ORDER_CURRENCY_PICKER_ENABLED=false
# ORDER_CURRENCY_ALLOWLIST=UZS,USD

# --- AR / collections (Gate-1 residual substance) ---
# AR_INVOICES_ENABLED=true
# AR_DUNNING_ENABLED=true   # advances dunning steps, bumps DelinquencyCount, auto-hold at T+21
# FORECAST_ACCURACY_ENABLED=true  # §8.4 nightly WAPE/bias/TS into ForecastAccuracyDaily
# FORECAST_ALGO_ENABLED=true      # §8.1 Croston/SES/Holt–Winters baseline writer
# FORECAST_SEASONAL_ESTIMATE_ENABLED=true  # Theatre #8 YoY calendar multiplier drafts (inactive overrides)
# FORECAST_ALGO_REQUIRE_GATE=false # backtest must beat 7d mean on ≥80% series when true
# SAFETY_STOCK_V2_ENABLED=true    # §8.2 z_α·√(L·σ_d²+d̄²·σ_L²); off keeps burn·lead·1.15
# SAFETY_STOCK_REPLAY_REQUIRE_GATE=false  # fail replay unless v2 cycle SL ≥ target−2pp and OH ≤ legacy×1.02
# AUTO_ORDER_SHADOW_ENABLED=true          # §8.3 persist shadow proposals (default on)
# AUTO_ORDER_INVENTORY_GROUNDED=true      # prefer (R,s,S); skip synthesis AI_PREORDER /2
# AUTO_ORDER_PLACE_ENABLED=false          # place mode process gate
# AUTO_ORDER_WORKER_ENABLED=false         # background sweep
# PARTNER_EXPORTS_ENABLED=true            # §8.9 Wave 2A bulk export worker/APIs
# PARTNER_EXPORT_LOCAL_ROOT=              # local object root (else GCS / tmp)
# PARTNER_SFTP_ENABLED=false              # optional SFTP push after export
# PARTNER_SFTP_SECRET_DEMO=               # GSM stand-in for SecretRef=demo
# PARTNER_EDI_ENABLED=true                # §8.9 Wave 2B EDI-lite workers
# PARTNER_EDI_LOCAL_ROOT=                 # local ORDERS drop / outbound pickup
# PARTNER_AS2_ENABLED=false               # §8.9 AS2 transport over EDI-lite
# PARTNER_AS2_INSECURE_PLAIN=false        # SSMR only: unsigned/unencrypted AS2 body
# PARTNER_AS2_SECRET_OUR_CERT=            # PEM cert for OurCertSecretRef
# PARTNER_AS2_SECRET_OUR_KEY=             # PEM key for OurKeySecretRef
# PARTNER_AS2_SECRET_PARTNER_CERT=        # PEM partner cert for PartnerCertSecretRef
# PARTNER_WEBHOOK_ALLOW_HTTP=false        # P2-14: require https webhook URLs
# PARTNER_WEBHOOK_ALLOW_PRIVATE=false     # P2-14: reject loopback/RFC1918 after DNS
# PARTNER_WEBHOOK_HOST_ALLOWLIST=         # optional comma hosts/suffixes (skips DNS private check)
# GS1_LABELS_ENABLED=true                 # §8.9 Wave 2C SSCC mint + ZPL labels
# GS1_COMPANY_PREFIX=                     # optional override (else SupplierProfiles.Gs1CompanyPrefix)

# --- Dispatch optimiser (OR-Tools sidecar: services/optimizer-core) ---
# Not the ai-worker process. Soft-fails to H3 BinPack when unset/unreachable.
# Local compose: http://optimizer-core:8082 — see docs/OPTIMIZER_AND_ROUTING_RUNTIME.md
# OPTIMIZER_BASE_URL=http://localhost:8082

# --- Route geometry (world-scale: Google Routes primary; OSRM optional regional fallback) ---
# ROUTING_PROVIDER=auto   # auto|google|osrm — auto tries Google → OSRM → dense
# ROUTING_OSRM_URL=http://localhost:5000

# Google Maps Platform server key (Geocoding + Places + Routes API)
# Enable routes.googleapis.com, Geocoding, Places on the GCP project.
# Restrict this key to backend egress IPs. Without it: Nominatim geocode + dense/OSRM geometry.
# GOOGLE_MAPS_API_KEY=

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Reliability strict mode ---
# When true, bootstrap fails fast if Redis, Kafka, or Spanner adapters are unavailable.
# Default is true for production safety. Set to false ONLY for local dev without infra.
REQUIRE_INFRA_ADAPTERS=true

# Production cutover: set PEGASUSX_ENV=production with non-dev webhook secrets and
# REQUIRE_INFRA_ADAPTERS=true so boot cannot start in scaffold/in-memory mode.
# PEGASUSX_ENV=production

# Portal demo seed (opt-in when Spanner is live; disabled by default in production paths)
# FACTORY_PORTAL_SEED=false
# PAYLOAD_PORTAL_SEED=false
# WAREHOUSE_PORTAL_SEED=false

# When true, enables API reliability middleware (rate limit + priority shed + circuit).
RELIABILITY_MIDDLEWARE_ENABLED=true

# G3 credit scoring v1 (default on). Weights: util 35% + delinquency 25% + DPD 25% + pay velocity 15%.
CREDIT_SCORING_ENABLED=true
# Optional: freeze when computed score <= max (dual-control recommended for prod).
CREDIT_SCORE_AUTO_HOLD_ENABLED=false
CREDIT_SCORE_AUTO_HOLD_MAX=25

# G4 tenancy: seed PreferTenant fallback (default off under ssmr/production).
# ALLOW_SEED_FALLBACK=true
# Platform admin password login (bootstrap when table empty):
# PLATFORM_ADMIN_SUBJECT=admin-a
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_EMAIL=
