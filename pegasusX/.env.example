# pegasusX environment example
# Copy to .env and fill in. Never commit secrets.

# --- Global Pay.UZ (primary payment rail — Boss provides production credentials) ---
GLOBAL_PAY_ENV=dev
# GLOBAL_PAY_SERVICE_ID=
# GLOBAL_PAY_USERNAME=
# GLOBAL_PAY_PASSWORD=

# --- WebSocket CORS (comma-separated portal origins in production) ---
# WS_ALLOWED_ORIGINS=https://supplier.example.com,https://warehouse.example.com

# --- GCS (supplier catalog images + CSV import; required for prod catalog) ---
# GCS_BUCKET_NAME=your-prod-catalog-bucket
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# --- Internal service auth (ai-worker optimizer) ---
# INTERNAL_API_KEY=

# --- Kafka freeze locks (ai-worker consumer) ---
# KAFKA_TOPIC_FREEZE_LOCKS=pegasusx-freeze-locks

# --- Feature flags ---
# ALLOCATION_REQUIRED=false keeps legacy single-warehouse reservation at order create.
# ALLOCATION_REQUIRED=true defers reservation and runs multi-warehouse allocation before dispatch.
ALLOCATION_REQUIRED=false
# CONSTRAINED_ALLOCATION_ENABLED=false keeps per-SKU first-fit allocation.
# CONSTRAINED_ALLOCATION_ENABLED=true picks one warehouse via segment/SKU policy scoring.
CONSTRAINED_ALLOCATION_ENABLED=false
# CONTROL_TOWER_PLAYBOOKS_ENABLED=false keeps exception lists manual-only (no playbook engine).
CONTROL_TOWER_PLAYBOOKS_ENABLED=false
# CONTROL_TOWER_PLAYBOOKS_AUTO_EXECUTE=false requires human Approve even when playbook AutoExecute=true.
CONTROL_TOWER_PLAYBOOKS_AUTO_EXECUTE=false
# MEIO_ECHELON_TARGETS_ENABLED=false keeps MEIO network summary without EchelonTargets writes.
MEIO_ECHELON_TARGETS_ENABLED=false
# TWIN_SCENARIO_ENABLED=false keeps planning scenario on heuristic path.
TWIN_SCENARIO_ENABLED=false
# CASH_RECONCILIATION_REQUIRED=false allows shift-end without driver cash reconciliation.
CASH_RECONCILIATION_REQUIRED=false
# CREDIT_NOTE_AUTO_FROM_BUYER_REJECT=false keeps buyer EHF rejection manual-only.
CREDIT_NOTE_AUTO_FROM_BUYER_REJECT=false
# CREDIT_NOTE_AUTO_FROM_CLAIM=false keeps claim approval without auto credit note.
CREDIT_NOTE_AUTO_FROM_CLAIM=false
# CREDIT_SCORE_ENFORCEMENT_ENABLED=false keeps shop-closed/credit-leave paths suggestion-only.
CREDIT_SCORE_ENFORCEMENT_ENABLED=false

# --- HTTP ---
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# --- Spanner (emulator by default) ---
SPANNER_EMULATOR_HOST=localhost:9010
SPANNER_PROJECT=pegasusx-local
SPANNER_INSTANCE=pegasusx-instance
SPANNER_DATABASE=pegasusx-db
# After `go run ./apps/backend-go/cmd/setup`, seed prod-sim smoke rows (vet-queue order + ledger):
#   cd apps/backend-go && go run ./cmd/seed-supplier-prodsim

# --- Redis ---
REDIS_ADDR=localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_MAIN=pegasusx-main

# --- Fiscal / OFD (ADR-009) ---
# FISCAL_PROVIDER=PEGASUS|FAKE|MY_SOLIQ|GLOBAL_PAY
FISCAL_PROVIDER=PEGASUS
# FISCAL_MY_SOLIQ_BASE_URL=
# FISCAL_MY_SOLIQ_API_KEY=
# FISCAL_MY_SOLIQ_TIN=
# FISCAL_MY_SOLIQ_PATH=/v1/receipts
# FISCAL_MY_SOLIQ_TIMEOUT_MS=8000
# FISCAL_GLOBAL_PAY_RECEIPT_ENABLED=false
# FISCAL_GLOBAL_PAY_RECEIPT_BASE_URL=
# FISCAL_GLOBAL_PAY_RECEIPT_API_KEY=

# --- Demo seed (never enable in staging/prod) ---
# USE_DEMO_SEED=false
# FACTORY_PORTAL_SEED=false

# --- Auth ---
JWT_SECRET=dev-only-change-me
JWT_ISSUER=pegasusx-dev

# --- Firebase Auth (optional, bearer token verification) ---
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CERTS_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com

# --- Webhook signature secrets (dev defaults in bootstrap if unset) ---
GLOBAL_PAY_WEBHOOK_SECRET=dev-global-pay-secret
ADYEN_WEBHOOK_SECRET=dev-adyen-secret
STRIPE_WEBHOOK_SECRET=dev-stripe-secret
PAYME_WEBHOOK_SECRET=dev-payme-secret
CLICK_WEBHOOK_SECRET=dev-click-secret

# Feature flag: when false, AIRWALLEX checkout execution is policy-blocked.
AIRWALLEX_DIRECT_EXECUTION_ENABLED=false

# --- Multi-supplier cap (schema always carries SupplierId) ---
MAX_SUPPLIERS=10

# --- Single tenant seed ---
SEED_SUPPLIER_NAME=pegasusX Supplier
SEED_SUPPLIER_COUNTRY=UZ
SEED_SUPPLIER_CURRENCY=UZS

# --- Dispatch optimiser (ai-worker sidecar) ---
# OPTIMIZER_BASE_URL=http://localhost:8081

# --- Route geometry (optional OSRM for street-following driver map polylines) ---
# ROUTING_OSRM_URL=http://localhost:5000

# Google Maps Platform (server-side geocode + Places autocomplete proxy for all clients)
# Enable Places API + Geocoding API on the GCP project. Without this, SSMR falls back to Nominatim.
# GOOGLE_MAPS_API_KEY=

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Reliability strict mode ---
# When true, bootstrap fails fast if Redis, Kafka, or Spanner adapters are unavailable.
# Default is true for production safety. Set to false ONLY for local dev without infra.
REQUIRE_INFRA_ADAPTERS=true

# Production cutover: set PEGASUSX_ENV=production with non-dev webhook secrets and
# REQUIRE_INFRA_ADAPTERS=true so boot cannot start in scaffold/in-memory mode.
# PEGASUSX_ENV=production

# Portal demo seed (opt-in when Spanner is live; disabled by default in production paths)
# FACTORY_PORTAL_SEED=false
# PAYLOAD_PORTAL_SEED=false
# WAREHOUSE_PORTAL_SEED=false

# When true, enables API reliability middleware (rate limit + priority shed + circuit).
RELIABILITY_MIDDLEWARE_ENABLED=true
