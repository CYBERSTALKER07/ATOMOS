<?xml version="1.0" encoding="UTF-8"?>
<!-- Merge into each iOS app Info.plist (or User-Defined build settings → INFOPLIST_KEY_*) for App Store archives. -->
<dict>
	<key>PXDistributionChannel</key>
	<string>production</string>
	<key>PXEnableCdnOta</key>
	<false/>
	<!-- Replace with real App Store Connect Apple ID after first listing: -->
	<key>PXAppStoreID</key>
	<string>REPLACE_WITH_APP_STORE_ID</string>
	<!-- Optional full URL overrides PXAppStoreID: -->
	<!-- <key>PXAppStoreURL</key><string>https://apps.apple.com/app/idREPLACE</string> -->
</dict>
