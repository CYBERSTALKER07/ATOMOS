{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasusx.local/contracts/events.schema.json",
  "title": "pegasusX Canonical Event Schemas",
  "description": "Source of truth for cross-stack event payloads. Consumed by Quicktype codegen for Android (Kotlin @Serializable) and iOS (Swift Codable), and by packages/types for TypeScript. All envelopes share the Envelope base shape; the discriminator is `type`.",
  "type": "object",
  "definitions": {
    "Envelope": {
      "type": "object",
      "required": ["type", "trace_id", "timestamp", "v"],
      "properties": {
        "type": { "type": "string" },
        "trace_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "v": { "type": "integer", "minimum": 1 },
        "schema_version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },

    "EventType": {
      "type": "string",
      "enum": [
        "SUPPLIER_CREATED",
        "RETAILER_REGISTERED",
        "DRIVER_CREATED",
        "VEHICLE_CREATED",
        "WAREHOUSE_CREATED",
        "WAREHOUSE_SUPPLY_REQUEST_OPENED",
        "WAREHOUSE_DISPATCH_LOCK_CHANGED",
        "FACTORY_CREATED",
        "ORDER_CREATED",
        "ORDER_STATUS_CHANGED",
        "ORDER_VALIDATION_FAILED",
        "ORDER_ASSIGNED",
        "ORDER_REASSIGNED",
        "ORDER_FINALIZED",
        "AI_RECOMMENDATION_CREATED",
        "AI_RECOMMENDATION_DECIDED",
        "ROUTE_CREATED",
        "MANIFEST_DRAFT_CREATED",
        "MANIFEST_LOADING_STARTED",
        "MANIFEST_ORDER_INJECTED",
        "MANIFEST_ORDER_EXCEPTION",
        "MANIFEST_DLQ_ESCALATION",
        "MANIFEST_REBALANCED",
        "MANIFEST_CANCELLED",
        "MANIFEST_SEALED",
        "MANIFEST_DISPATCHED",
        "MANIFEST_COMPLETED",
        "PAYMENT_CLEARED",
        "PAYMENT_REQUIRED",
        "SETTLEMENT_REQUIRED",
        "DELIVERY_SESSION_UPDATED",
        "DELIVERY_DISPUTED",
        "DRIVER_AVAILABILITY_CHANGED",
        "DRIVER_LOCATION_UPDATED",
        "SHOP_CLOSED",
        "SHOP_CLOSED_RESPONSE",
        "CART_SYNC_UPDATED",
        "INVENTORY_SYNC_COMPLETE",
        "COMMAND_DISPATCHED",
        "COMMAND_RECEIVED",
        "COMMAND_SETTLED",
        "SYSTEM_APP_OUTDATED"
      ]
    },

    "AIRecommendationCreated": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["recommendation_id", "supplier_id", "aggregate_id", "aggregate_type", "action", "status", "score", "confidence", "explanation", "reason_codes"],
          "properties": {
            "type": { "const": "AI_RECOMMENDATION_CREATED" },
            "recommendation_id": { "type": "string" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "aggregate_id": { "type": "string" },
            "aggregate_type": { "type": "string" },
            "action": { "type": "string" },
            "status": { "type": "string" },
            "score": { "type": "number" },
            "confidence": { "type": "number" },
            "explanation": { "type": "string" },
            "reason_codes": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      ]
    },

    "AIRecommendationDecided": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["recommendation_id", "supplier_id", "aggregate_id", "aggregate_type", "decision", "status", "decided_by", "decided_at"],
          "properties": {
            "type": { "const": "AI_RECOMMENDATION_DECIDED" },
            "recommendation_id": { "type": "string" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "aggregate_id": { "type": "string" },
            "aggregate_type": { "type": "string" },
            "decision": { "type": "string", "enum": ["ACKNOWLEDGED", "OVERRIDDEN", "DISMISSED", "REOPENED"] },
            "status": { "type": "string" },
            "decided_by": { "type": "string" },
            "decided_at": { "type": "string", "format": "date-time" },
            "note": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },

    "Money": {
      "type": "object",
      "required": ["amount", "currency"],
      "description": "int64 minor units + ISO-4217 currency. Never float.",
      "properties": {
        "amount": { "type": "integer" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
      }
    },

    "OrderSource": {
      "type": "string",
      "enum": ["MANUAL", "MANUAL_PREORDER", "AI_PREORDER"]
    },

    "OrderConfirmationStatus": {
      "type": "string",
      "enum": ["CONFIRMED", "DRAFT", "PENDING", "REJECTED", "AUTO_CONFIRMED"]
    },

    "OrderLineItem": {
      "type": "object",
      "required": ["sku", "quantity", "unit_price_minor"],
      "properties": {
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "unit_price_minor": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "HomeNode": {
      "type": "object",
      "required": ["home_node_type", "home_node_id"],
      "properties": {
        "home_node_type": { "type": "string", "enum": ["WAREHOUSE", "FACTORY"] },
        "home_node_id": { "type": "string", "format": "uuid" }
      }
    },

    "SupplierCreated": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["supplier_id", "name", "country", "currency"],
          "properties": {
            "supplier_id": { "type": "string", "format": "uuid" },
            "name": { "type": "string" },
            "country": { "type": "string", "minLength": 2, "maxLength": 2 },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
          }
        }
      ]
    },

    "RetailerRegistered": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["retailer_id", "phone", "h3_cell", "lat", "lng"],
          "properties": {
            "retailer_id": { "type": "string", "format": "uuid" },
            "phone": { "type": "string" },
            "name": { "type": "string" },
            "h3_cell": { "type": "string", "minLength": 15, "maxLength": 15 },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        }
      ]
    },

    "DriverCreated": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        { "$ref": "#/definitions/HomeNode" },
        {
          "type": "object",
          "required": ["driver_id", "supplier_id", "phone"],
          "properties": {
            "driver_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "phone": { "type": "string" },
            "name": { "type": "string" }
          }
        }
      ]
    },

    "VehicleCreated": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        { "$ref": "#/definitions/HomeNode" },
        {
          "type": "object",
          "required": ["vehicle_id", "supplier_id", "plate"],
          "properties": {
            "vehicle_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "plate": { "type": "string" },
            "max_vu": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },

    "WarehouseCreated": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["warehouse_id", "supplier_id", "h3_cell", "lat", "lng"],
          "properties": {
            "warehouse_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "name": { "type": "string" },
            "h3_cell": { "type": "string", "minLength": 15, "maxLength": 15 },
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "max_vu": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },

    "WarehouseSupplyRequestOpened": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["supplier_id", "request_id", "status", "timestamp"],
          "properties": {
            "supplier_id": { "type": "string", "format": "uuid" },
            "warehouse_id": { "type": "string", "format": "uuid" },
            "request_id": { "type": "string" },
            "status": { "type": "string" },
            "state": { "type": "string" },
            "requested_by": { "type": "string" },
            "coverage_start_date": { "type": "string" },
            "coverage_days": { "type": "integer", "minimum": 1 },
            "projected_units": { "type": "integer", "minimum": 0 },
            "committed_units": { "type": "integer", "minimum": 0 },
            "pending_confirmation_units": { "type": "integer", "minimum": 0 },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },

    "WarehouseDispatchLockChanged": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["supplier_id", "lock_id", "action", "timestamp"],
          "properties": {
            "supplier_id": { "type": "string", "format": "uuid" },
            "warehouse_id": { "type": "string", "format": "uuid" },
            "lock_id": { "type": "string" },
            "entity_type": { "type": "string" },
            "entity_id": { "type": "string" },
            "reason": { "type": "string" },
            "action": { "type": "string", "enum": ["ACQUIRED", "RELEASED"] },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },

    "FactoryCreated": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["factory_id", "supplier_id", "h3_cell", "lat", "lng"],
          "properties": {
            "factory_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "name": { "type": "string" },
            "h3_cell": { "type": "string", "minLength": 15, "maxLength": 15 },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        }
      ]
    },

    "OrderCreated": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["order_id", "retailer_id", "supplier_id", "status", "total_minor", "currency", "h3_cell", "lat", "lng"],
          "properties": {
            "type": { "const": "ORDER_CREATED" },
            "order_id": { "type": "string", "format": "uuid" },
            "retailer_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "warehouse_id": { "type": "string", "format": "uuid" },
            "status": { "type": "string", "enum": ["PENDING", "LOADED", "IN_TRANSIT", "ARRIVED", "AWAITING_PAYMENT", "PENDING_CASH_COLLECTION", "COMPLETED", "CANCELLED"] },
            "order_source": { "$ref": "#/definitions/OrderSource" },
            "confirmation_status": { "$ref": "#/definitions/OrderConfirmationStatus" },
            "requested_delivery_date": { "type": "string", "format": "date-time" },
            "line_items": { "type": "array", "items": { "$ref": "#/definitions/OrderLineItem" } },
            "total_minor": { "type": "integer" },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "h3_cell": { "type": "string", "minLength": 15, "maxLength": 15 },
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "receiving_window_open": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "receiving_window_close": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
          }
        }
      ]
    },

    "OrderStatusChanged": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["order_id", "supplier_id", "retailer_id", "previous_status", "status"],
          "properties": {
            "type": { "const": "ORDER_STATUS_CHANGED" },
            "order_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "retailer_id": { "type": "string", "format": "uuid" },
            "previous_status": { "type": "string", "enum": ["PENDING", "LOADED", "IN_TRANSIT", "ARRIVED", "AWAITING_PAYMENT", "PENDING_CASH_COLLECTION", "COMPLETED", "CANCELLED"] },
            "status": { "type": "string", "enum": ["PENDING", "LOADED", "IN_TRANSIT", "ARRIVED", "AWAITING_PAYMENT", "PENDING_CASH_COLLECTION", "COMPLETED", "CANCELLED"] },
            "reason": { "type": "string" },
            "actor_role": { "type": "string" },
            "actor_id": { "type": "string" },
            "order_source": { "$ref": "#/definitions/OrderSource" },
            "confirmation_status": { "$ref": "#/definitions/OrderConfirmationStatus" },
            "requested_delivery_date": { "type": "string", "format": "date-time" },
            "version": { "type": "integer", "minimum": 1 },
            "total_minor": { "type": "integer" },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
          }
        }
      ]
    },

    "OrderValidationFailed": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["order_id", "reason"],
          "properties": {
            "order_id": { "type": "string", "format": "uuid" },
            "reason": { "type": "string" }
          }
        }
      ]
    },

    "OrderAssigned": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["order_id", "driver_id", "route_id"],
          "properties": {
            "order_id": { "type": "string", "format": "uuid" },
            "driver_id": { "type": "string", "format": "uuid" },
            "route_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "retailer_id": { "type": "string", "format": "uuid" },
            "warehouse_id": { "type": "string", "format": "uuid" },
            "vehicle_id": { "type": "string", "format": "uuid" },
            "manifest_id": { "type": "string", "format": "uuid" }
          }
        }
      ]
    },

    "OrderReassigned": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["order_id", "from_driver_id", "to_driver_id"],
          "properties": {
            "order_id": { "type": "string", "format": "uuid" },
            "from_driver_id": { "type": "string", "format": "uuid" },
            "to_driver_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "retailer_id": { "type": "string", "format": "uuid" },
            "warehouse_id": { "type": "string", "format": "uuid" },
            "from_route_id": { "type": "string", "format": "uuid" },
            "to_route_id": { "type": "string", "format": "uuid" },
            "vehicle_id": { "type": "string", "format": "uuid" },
            "manifest_id": { "type": "string", "format": "uuid" }
          }
        }
      ]
    },

    "OrderFinalized": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["order_id", "total"],
          "properties": {
            "order_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "retailer_id": { "type": "string", "format": "uuid" },
            "total": { "$ref": "#/definitions/Money" },
            "amount_minor": { "type": "integer" },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "status": { "type": "string" },
            "fee_amount": { "type": "integer" },
            "net_payout_amount": { "type": "integer" }
          }
        }
      ]
    },

    "PaymentRequired": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["order_id", "amount"],
          "properties": {
            "order_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "retailer_id": { "type": "string", "format": "uuid" },
            "amount": { "$ref": "#/definitions/Money" },
            "amount_minor": { "type": "integer" },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "payment_method": { "type": "string" },
            "status": { "type": "string" }
          }
        }
      ]
    },

    "PaymentCleared": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["order_id", "amount"],
          "properties": {
            "order_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "retailer_id": { "type": "string", "format": "uuid" },
            "amount": { "$ref": "#/definitions/Money" },
            "amount_minor": { "type": "integer" },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "gateway": { "type": "string", "enum": ["GLOBAL_PAY", "ADYEN", "AIRWALLEX", "CASH"] },
            "payment_method": { "type": "string" },
            "status": { "type": "string" },
            "provider_reference": { "type": "string" }
          }
        }
      ]
    },

    "SettlementRequired": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["order_id", "amount"],
          "properties": {
            "order_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "retailer_id": { "type": "string", "format": "uuid" },
            "session_id": { "type": "string", "format": "uuid" },
            "amount": { "$ref": "#/definitions/Money" },
            "amount_minor": { "type": "integer" },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "payment_method": { "type": "string" },
            "status": { "type": "string" }
          }
        }
      ]
    },

    "DeliverySessionUpdated": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["session_id", "order_id"],
          "properties": {
            "session_id": { "type": "string", "format": "uuid" },
            "order_id": { "type": "string", "format": "uuid" },
            "amount": { "type": "integer" },
            "original_amount": { "type": "integer" },
            "adjusted_amount": { "type": "integer" },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
          }
        }
      ]
    },

    "DriverAvailabilityChanged": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["driver_id", "available"],
          "properties": {
            "driver_id": { "type": "string", "format": "uuid" },
            "available": { "type": "boolean" },
            "on_shift": { "type": "boolean" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "home_node_type": { "type": "string", "enum": ["WAREHOUSE", "FACTORY"] },
            "home_node_id": { "type": "string", "format": "uuid" },
            "reason": { "type": "string" }
          }
        }
      ]
    },

    "DriverLocationUpdated": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "data": {
              "type": "object",
              "required": ["driver_id", "supplier_id", "lat", "lng", "latitude", "longitude", "reported_at", "received_at", "stale_after_seconds"],
              "properties": {
                "driver_id": { "type": "string" },
                "supplier_id": { "type": "string" },
                "lat": { "type": "number", "minimum": -90, "maximum": 90 },
                "lng": { "type": "number", "minimum": -180, "maximum": 180 },
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
                "velocity": { "type": "number" },
                "heading": { "type": "number" },
                "reported_at": { "type": "string", "format": "date-time" },
                "received_at": { "type": "string", "format": "date-time" },
                "stale_after_seconds": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      ]
    },

    "ManifestDraftCreated": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["manifest_id"],
          "properties": {
            "manifest_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "route_id": { "type": "string" },
            "transfer_count": { "type": "integer", "minimum": 0 },
            "total_volume_vu": { "type": "integer", "minimum": 0 },
            "driver_id": { "type": "string" },
            "vehicle_id": { "type": "string" }
          }
        }
      ]
    },

    "ManifestLoadingStarted": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["manifest_id", "state"],
          "properties": {
            "manifest_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "state": { "type": "string" },
            "route_id": { "type": "string" },
            "driver_id": { "type": "string" },
            "vehicle_id": { "type": "string" },
            "order_count": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },

    "ManifestOrderInjected": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["manifest_id", "order_id"],
          "properties": {
            "manifest_id": { "type": "string", "format": "uuid" },
            "order_id": { "type": "string", "format": "uuid" },
            "supplier_id": { "type": "string", "format": "uuid" },
            "total_volume_vu": { "type": "integer", "minimum": 0 },
            "stop_count": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },

    "ManifestOrderException": {
      "allOf": [
        { "$ref": "#/definitions/Envelope" },
        {
          "type": "object",
          "required": ["manifest_id", "reason"],
          "properties": {
            "manifest_id": { "type": "string", "format": "uuid" },
