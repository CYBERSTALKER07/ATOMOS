{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasusx.dev/contracts/ontology/sku.v1.schema.json",
  "title": "SKUOntologyObjectV1",
  "description": "Catalog product / SKU with handling, cold-chain, and integer minor-unit list pricing.",
  "x-ontology-version": "1.0.0",
  "x-schema-version": "v1",
  "x-object-type": "SKU",
  "x-primary-key": [
    "cell_id",
    "object_type",
    "object_id"
  ],
  "x-default-security-markings": [
    "MARKING:FINANCE_ONLY"
  ],
  "x-allowed-link-types": [
    "supplies",
    "stocks",
    "ordered",
    "shipped_on",
    "owes",
    "substitutes",
    "recalled_with"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id",
    "object_type",
    "object_id",
    "supplier_id",
    "version",
    "properties",
    "valid_from",
    "updated_at"
  ],
  "properties": {
    "cell_id": {
      "type": "string",
      "minLength": 1,
      "description": "Cell/region partition coordinate"
    },
    "object_type": {
      "type": "string",
      "const": "SKU"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique entity identifier within cell+type"
    },
    "supplier_id": {
      "type": "string",
      "description": "Tenant supplier identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic optimistic-concurrency version"
    },
    "security_markings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MARKING:FINANCE_ONLY",
          "MARKING:PII",
          "MARKING:AML_INVESTIGATION",
          "MARKING:DISCREPANT_QUARANTINE",
          "MARKING:THERMAL_QUARANTINE_SPOILED",
          "MARKING:MICRO_SKIMMING_SUSPECT",
          "MARKING:LOT_RECALL_QUARANTINE"
        ]
      },
      "uniqueItems": true,
      "description": "Data governance & quarantine markings"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "string",
          "description": "Product UUID"
        },
        "sku": {
          "type": "string",
          "description": "SKU code"
        },
        "supplier_id": {
          "type": "string",
          "description": "Owning supplier ID"
        },
        "category_id": {
          "type": "string",
          "description": "Category ID"
        },
        "name": {
          "type": "string",
          "description": "Product title"
        },
        "barcode": {
          "type": "string",
          "description": "EAN/UPC barcode"
        },
        "ikpu_code": {
          "type": "string",
          "description": "Soliq IKPU fiscal classification code"
        },
        "package_code": {
          "type": "string",
          "description": "Soliq package code"
        },
        "price_minor": {
          "type": "integer",
          "description": "Unit catalog price (int64 minor units; zero floats)"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 8,
          "description": "ISO 4217 currency code"
        },
        "stock_quantity": {
          "type": "integer",
          "description": "Aggregated stock quantity"
        },
        "unit": {
          "type": "string",
          "description": "Base unit"
        },
        "sale_unit": {
          "type": "string",
          "description": "Sale unit"
        },
        "units_per_pack": {
          "type": "integer",
          "description": "Units per pack/case"
        },
        "handling_class": {
          "type": "string",
          "description": "GENERAL | COLD | FROZEN | HAZARDOUS"
        },
        "requires_cold_chain": {
          "type": "boolean",
          "description": "Cold-chain requirement flag"
        },
        "is_hazardous": {
          "type": "boolean",
          "description": "Hazardous material flag"
        },
        "is_perishable": {
          "type": "boolean",
          "description": "Perishable shelf-life flag"
        },
        "min_shelf_life_days": {
          "type": "integer",
          "description": "Minimum shelf life days"
        },
        "stackable": {
          "type": "boolean",
          "description": "3D stackable flag"
        },
        "max_stack_height": {
          "type": "integer",
          "description": "Maximum stack layers"
        },
        "unit_volume_vu": {
          "type": "number",
          "description": "Volumetric units per sale unit"
        },
        "is_active": {
          "type": "boolean",
          "description": "Active flag"
        },
        "version": {
          "type": "integer",
          "description": "Catalog entity version"
        }
      }
    }
  }
}
