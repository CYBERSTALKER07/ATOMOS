{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasusx.dev/contracts/ontology/lot.v1.schema.json",
  "title": "LotOntologyObjectV1",
  "description": "Trackable warehouse inventory batch/lot with FEFO expiry and recall quarantine state.",
  "x-ontology-version": "1.0.0",
  "x-schema-version": "v1",
  "x-object-type": "Lot",
  "x-primary-key": [
    "cell_id",
    "object_type",
    "object_id"
  ],
  "x-default-security-markings": [],
  "x-allowed-link-types": [
    "supplies",
    "stocks",
    "ordered",
    "shipped_on",
    "owes",
    "substitutes",
    "recalled_with"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id",
    "object_type",
    "object_id",
    "supplier_id",
    "version",
    "properties",
    "valid_from",
    "updated_at"
  ],
  "properties": {
    "cell_id": {
      "type": "string",
      "minLength": 1,
      "description": "Cell/region partition coordinate"
    },
    "object_type": {
      "type": "string",
      "const": "Lot"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique entity identifier within cell+type"
    },
    "supplier_id": {
      "type": "string",
      "description": "Tenant supplier identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic optimistic-concurrency version"
    },
    "security_markings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MARKING:FINANCE_ONLY",
          "MARKING:PII",
          "MARKING:AML_INVESTIGATION",
          "MARKING:DISCREPANT_QUARANTINE",
          "MARKING:THERMAL_QUARANTINE_SPOILED",
          "MARKING:MICRO_SKIMMING_SUSPECT",
          "MARKING:LOT_RECALL_QUARANTINE"
        ]
      },
      "uniqueItems": true,
      "description": "Data governance & quarantine markings"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lot_id": {
          "type": "string",
          "description": "Stock lot UUID"
        },
        "supplier_id": {
          "type": "string",
          "description": "Owning supplier ID"
        },
        "warehouse_id": {
          "type": "string",
          "description": "Warehouse ID"
        },
        "product_id": {
          "type": "string",
          "description": "Product ID"
        },
        "sku": {
          "type": "string",
          "description": "SKU code"
        },
        "location_id": {
          "type": "string",
          "description": "Warehouse bin/location ID"
        },
        "lot_code": {
          "type": "string",
          "description": "Manufacturer batch/lot code"
        },
        "status": {
          "type": "string",
          "description": "AVAILABLE | QUARANTINED | RECALLED | DEPLETED | EXPIRED"
        },
        "quantity_on_hand": {
          "type": "integer",
          "description": "On-hand units"
        },
        "quantity_reserved": {
          "type": "integer",
          "description": "Reserved units"
        },
        "quantity_available": {
          "type": "integer",
          "description": "Available units"
        },
        "manufactured_date": {
          "type": "string",
          "description": "YYYY-MM-DD manufacture date"
        },
        "expiry_date": {
          "type": "string",
          "description": "YYYY-MM-DD expiry date"
        },
        "received_at": {
          "type": "string",
          "description": "RFC3339 timestamp received"
        },
        "recall_reason": {
          "type": "string",
          "description": "Recall/quarantine reason if applicable"
        }
      }
    }
  }
}
