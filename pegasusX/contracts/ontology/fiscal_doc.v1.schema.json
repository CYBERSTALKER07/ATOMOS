{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasusx.dev/contracts/ontology/fiscal_doc.v1.schema.json",
  "title": "FiscalDocOntologyObjectV1",
  "description": "Soliq fiscal receipt, EHF invoice, or corrective fiscal credit note.",
  "x-ontology-version": "1.0.0",
  "x-schema-version": "v1",
  "x-object-type": "FiscalDoc",
  "x-primary-key": [
    "cell_id",
    "object_type",
    "object_id"
  ],
  "x-default-security-markings": [
    "MARKING:FINANCE_ONLY"
  ],
  "x-allowed-link-types": [
    "supplies",
    "stocks",
    "ordered",
    "shipped_on",
    "owes",
    "substitutes",
    "recalled_with"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id",
    "object_type",
    "object_id",
    "supplier_id",
    "version",
    "properties",
    "valid_from",
    "updated_at"
  ],
  "properties": {
    "cell_id": {
      "type": "string",
      "minLength": 1,
      "description": "Cell/region partition coordinate"
    },
    "object_type": {
      "type": "string",
      "const": "FiscalDoc"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique entity identifier within cell+type"
    },
    "supplier_id": {
      "type": "string",
      "description": "Tenant supplier identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic optimistic-concurrency version"
    },
    "security_markings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MARKING:FINANCE_ONLY",
          "MARKING:PII",
          "MARKING:AML_INVESTIGATION",
          "MARKING:DISCREPANT_QUARANTINE",
          "MARKING:THERMAL_QUARANTINE_SPOILED",
          "MARKING:MICRO_SKIMMING_SUSPECT",
          "MARKING:LOT_RECALL_QUARANTINE"
        ]
      },
      "uniqueItems": true,
      "description": "Data governance & quarantine markings"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fiscal_doc_id": {
          "type": "string",
          "description": "Canonical fiscal doc ID"
        },
        "attempt_id": {
          "type": "string",
          "description": "Fiscal attempt UUID"
        },
        "order_id": {
          "type": "string",
          "description": "Order UUID"
        },
        "credit_note_id": {
          "type": "string",
          "description": "CreditNote UUID if corrective"
        },
        "supplier_id": {
          "type": "string",
          "description": "Supplier ID"
        },
        "retailer_id": {
          "type": "string",
          "description": "Retailer ID"
        },
        "provider": {
          "type": "string",
          "description": "SOLIQ | EHF | MULTIKASSA"
        },
        "doc_type": {
          "type": "string",
          "description": "RECEIPT | EHF | CORRECTIVE_EHF"
        },
        "status": {
          "type": "string",
          "description": "PENDING | SUCCEEDED | REGISTERED_SOLIQ | FAILED"
        },
        "fiscal_receipt_id": {
          "type": "string",
          "description": "Provider fiscal receipt ID"
        },
        "ehf_id": {
          "type": "string",
          "description": "Soliq EHF document ID"
        },
        "buyer_acceptance_status": {
          "type": "string",
          "description": "PENDING | ACCEPTED | REJECTED | EXPIRED"
        },
        "amount_minor": {
          "type": "integer",
          "description": "Total fiscalized amount (int64 minor units; zero floats)"
        },
        "net_minor": {
          "type": "integer",
          "description": "Net amount excluding VAT (int64 minor units; zero floats)"
        },
        "vat_minor": {
          "type": "integer",
          "description": "VAT amount (int64 minor units; zero floats)"
        },
        "gross_minor": {
          "type": "integer",
          "description": "Gross amount including VAT (int64 minor units; zero floats)"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 8,
          "description": "ISO 4217 currency code"
        },
        "payment_method": {
          "type": "string",
          "description": "Payment method declared on fiscal doc"
        },
        "fiscal_qr": {
          "type": "string",
          "description": "Fiscal verification QR payload"
        }
      }
    }
  }
}
