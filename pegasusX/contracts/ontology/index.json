{
  "version": "1.0.0",
  "schema_version": "v1",
  "primary_key": [
    "cell_id",
    "object_type",
    "object_id"
  ],
  "monetary_unit": "minor_unit_int64",
  "allowed_link_types": [
    "supplies",
    "stocks",
    "ordered",
    "shipped_on",
    "owes",
    "substitutes",
    "recalled_with"
  ],
  "link_descriptors": [
    {
      "link_type": "supplies",
      "description": "Supplier or Factory supplies a Warehouse, SKU, or Shop.",
      "source_types": [
        "Supplier",
        "Factory",
        "LegalEntity"
      ],
      "target_types": [
        "Warehouse",
        "SKU",
        "Shop"
      ],
      "propagates_markings": false
    },
    {
      "link_type": "stocks",
      "description": "Warehouse stocks a SKU or Lot, or SKU is stocked in Lot.",
      "source_types": [
        "Warehouse",
        "SKU"
      ],
      "target_types": [
        "SKU",
        "Lot"
      ],
      "propagates_markings": true
    },
    {
      "link_type": "ordered",
      "description": "Shop placed an Order or Order contains OrderLine / references SKU / Proposal.",
      "source_types": [
        "Shop",
        "Order",
        "Proposal"
      ],
      "target_types": [
        "Order",
        "OrderLine",
        "SKU",
        "Lot"
      ],
      "propagates_markings": true
    },
    {
      "link_type": "shipped_on",
      "description": "Order or OrderLine is shipped on a Manifest operated by Vehicle and Driver.",
      "source_types": [
        "Order",
        "OrderLine",
        "Manifest",
        "Driver"
      ],
      "target_types": [
        "Manifest",
        "Vehicle",
        "Driver",
        "Warehouse"
      ],
      "propagates_markings": true
    },
    {
      "link_type": "owes",
      "description": "Shop or LegalEntity owes on a NasiyaInvoice, CreditLine, Payment, or FiscalDoc.",
      "source_types": [
        "Shop",
        "LegalEntity",
        "Order",
        "NasiyaInvoice"
      ],
      "target_types": [
        "NasiyaInvoice",
        "CreditLine",
        "Payment",
        "FiscalDoc",
        "Supplier"
      ],
      "propagates_markings": false
    },
    {
      "link_type": "substitutes",
      "description": "SKU or Proposal substitutes an out-of-stock or constrained SKU.",
      "source_types": [
        "SKU",
        "Proposal"
      ],
      "target_types": [
        "SKU"
      ],
      "propagates_markings": false
    },
    {
      "link_type": "recalled_with",
      "description": "Lot recall lineage linking contaminated Lot to affected Lots, Orders, Manifests, or FiscalDocs.",
      "source_types": [
        "Lot"
      ],
      "target_types": [
        "Lot",
        "Order",
        "OrderLine",
        "Manifest",
        "FiscalDoc"
      ],
      "propagates_markings": true
    }
  ],
  "security_markings": [
    {
      "marking": "MARKING:FINANCE_ONLY",
      "category": "access_control",
      "requires_finance_or_admin": true,
      "propagates": false,
      "description": "Financial figures, credit exposure, balances, and payment settlements restricted to finance/admin roles."
    },
    {
      "marking": "MARKING:PII",
      "category": "privacy",
      "requires_finance_or_admin": true,
      "propagates": false,
      "description": "Personally identifiable information (phone, email, address, tax TIN) masked for non-finance/non-admin viewers."
    },
    {
      "marking": "MARKING:AML_INVESTIGATION",
      "category": "quarantine",
      "requires_finance_or_admin": true,
      "propagates": true,
      "description": "Daily cash AML ceiling investigation quarantine propagated across linked settlement entities."
    },
    {
      "marking": "MARKING:DISCREPANT_QUARANTINE",
      "category": "quarantine",
      "requires_finance_or_admin": false,
      "propagates": true,
      "description": "Blind-count cash or stock variance quarantine propagated downstream."
    },
    {
      "marking": "MARKING:THERMAL_QUARANTINE_SPOILED",
      "category": "quarantine",
      "requires_finance_or_admin": false,
      "propagates": true,
      "description": "Cold-chain thermal excursion spoilage quarantine propagated along lot/manifest lineage."
    },
    {
      "marking": "MARKING:MICRO_SKIMMING_SUSPECT",
      "category": "quarantine",
      "requires_finance_or_admin": true,
      "propagates": true,
      "description": "Repeated driver variance anomaly marking propagated to linked audit/cashier objects."
    },
    {
      "marking": "MARKING:LOT_RECALL_QUARANTINE",
      "category": "quarantine",
      "requires_finance_or_admin": false,
      "propagates": true,
      "description": "Contaminated lot recall quarantine propagated forward through orders and fiscal documents."
    }
  ],
  "object_types": [
