{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasusx.dev/contracts/ontology/shop.v1.schema.json",
  "title": "ShopOntologyObjectV1",
  "description": "Retailer / store outlet ordering from suppliers.",
  "x-ontology-version": "1.0.0",
  "x-schema-version": "v1",
  "x-object-type": "Shop",
  "x-primary-key": [
    "cell_id",
    "object_type",
    "object_id"
  ],
  "x-default-security-markings": [
    "MARKING:PII"
  ],
  "x-allowed-link-types": [
    "supplies",
    "stocks",
    "ordered",
    "shipped_on",
    "owes",
    "substitutes",
    "recalled_with"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id",
    "object_type",
    "object_id",
    "supplier_id",
    "version",
    "properties",
    "valid_from",
    "updated_at"
  ],
  "properties": {
    "cell_id": {
      "type": "string",
      "minLength": 1,
      "description": "Cell/region partition coordinate"
    },
    "object_type": {
      "type": "string",
      "const": "Shop"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique entity identifier within cell+type"
    },
    "supplier_id": {
      "type": "string",
      "description": "Tenant supplier identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic optimistic-concurrency version"
    },
    "security_markings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MARKING:FINANCE_ONLY",
          "MARKING:PII",
          "MARKING:AML_INVESTIGATION",
          "MARKING:DISCREPANT_QUARANTINE",
          "MARKING:THERMAL_QUARANTINE_SPOILED",
          "MARKING:MICRO_SKIMMING_SUSPECT",
          "MARKING:LOT_RECALL_QUARANTINE"
        ]
      },
      "uniqueItems": true,
      "description": "Data governance & quarantine markings"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retailer_id": {
          "type": "string",
          "description": "Retailer UUID"
        },
        "shop_id": {
          "type": "string",
          "description": "Shop/branch location ID"
        },
        "supplier_id": {
          "type": "string",
          "description": "Contextual supplier ID"
        },
        "name": {
          "type": "string",
          "description": "Shop display name"
        },
        "legal_name": {
          "type": "string",
          "description": "Registered business name"
        },
        "phone": {
          "type": "string",
          "description": "Shop contact phone (PII)"
        },
        "email": {
          "type": "string",
          "description": "Shop contact email (PII)"
        },
        "tax_id": {
          "type": "string",
          "description": "Shop tax ID / INN (PII)"
        },
        "normalized_tax_id": {
          "type": "string",
          "description": "Canonicalized TIN (PII)"
        },
        "country_code": {
          "type": "string",
          "description": "Country code"
        },
        "region_id": {
          "type": "string",
          "description": "Region ID"
        },
        "h3_cell": {
          "type": "string",
          "description": "H3 spatial cell"
        },
        "delivery_address": {
          "type": "string",
          "description": "Delivery street address (PII)"
        },
        "gln": {
          "type": "string",
          "description": "GS1 GLN"
        },
        "receiving_window_open": {
          "type": "string",
          "description": "HH:MM receiving window open"
        },
        "receiving_window_close": {
          "type": "string",
          "description": "HH:MM receiving window close"
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone"
        },
        "min_shelf_life_days": {
          "type": "integer",
          "description": "Minimum accepted shelf-life days"
        },
        "segment": {
          "type": "string",
          "description": "Retailer tier/segment"
        },
        "lat": {
          "type": "number",
          "description": "Latitude"
        },
        "lng": {
          "type": "number",
          "description": "Longitude"
        }
      }
    }
  }
}
