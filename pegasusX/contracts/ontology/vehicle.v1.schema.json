{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasusx.dev/contracts/ontology/vehicle.v1.schema.json",
  "title": "VehicleOntologyObjectV1",
  "description": "Delivery fleet vehicle with capacity class and DVIR dispatch clearance.",
  "x-ontology-version": "1.0.0",
  "x-schema-version": "v1",
  "x-object-type": "Vehicle",
  "x-primary-key": [
    "cell_id",
    "object_type",
    "object_id"
  ],
  "x-default-security-markings": [],
  "x-allowed-link-types": [
    "supplies",
    "stocks",
    "ordered",
    "shipped_on",
    "owes",
    "substitutes",
    "recalled_with"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id",
    "object_type",
    "object_id",
    "supplier_id",
    "version",
    "properties",
    "valid_from",
    "updated_at"
  ],
  "properties": {
    "cell_id": {
      "type": "string",
      "minLength": 1,
      "description": "Cell/region partition coordinate"
    },
    "object_type": {
      "type": "string",
      "const": "Vehicle"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique entity identifier within cell+type"
    },
    "supplier_id": {
      "type": "string",
      "description": "Tenant supplier identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic optimistic-concurrency version"
    },
    "security_markings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MARKING:FINANCE_ONLY",
          "MARKING:PII",
          "MARKING:AML_INVESTIGATION",
          "MARKING:DISCREPANT_QUARANTINE",
          "MARKING:THERMAL_QUARANTINE_SPOILED",
          "MARKING:MICRO_SKIMMING_SUSPECT",
          "MARKING:LOT_RECALL_QUARANTINE"
        ]
      },
      "uniqueItems": true,
      "description": "Data governance & quarantine markings"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vehicle_id": {
          "type": "string",
          "description": "Vehicle UUID"
        },
        "supplier_id": {
          "type": "string",
          "description": "Supplier ID"
        },
        "label": {
          "type": "string",
          "description": "Fleet label"
        },
        "license_plate": {
          "type": "string",
          "description": "Registration license plate"
        },
        "home_node_type": {
          "type": "string",
          "description": "WAREHOUSE | FACTORY"
        },
        "home_node_id": {
          "type": "string",
          "description": "Home node UUID"
        },
        "vehicle_class": {
          "type": "string",
          "description": "CLASS_A | CLASS_B | CLASS_C"
        },
        "max_volume_vu": {
          "type": "number",
          "description": "Maximum capacity in VU"
        },
        "is_active": {
          "type": "boolean",
          "description": "Active flag"
        },
        "unavailable_reason": {
          "type": "string",
          "description": "Unavailable reason"
        },
        "dvir_status": {
          "type": "string",
          "description": "DISPATCH_AUTHORIZED | RED_TAG_QUARANTINE"
        },
        "red_tag_applied": {
          "type": "boolean",
          "description": "DVIR red-tag active"
        },
        "dispatch_authorized": {
          "type": "boolean",
          "description": "Authorized for dispatch"
        }
      }
    }
  }
}
