{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasusx.dev/contracts/ontology/legal_entity.v1.schema.json",
  "title": "LegalEntityOntologyObjectV1",
  "description": "Legal/tax counterparty entity anchored by TIN/INN for KYB, AML cash ceilings, and settlements.",
  "x-ontology-version": "1.0.0",
  "x-schema-version": "v1",
  "x-object-type": "LegalEntity",
  "x-primary-key": [
    "cell_id",
    "object_type",
    "object_id"
  ],
  "x-default-security-markings": [
    "MARKING:FINANCE_ONLY",
    "MARKING:PII"
  ],
  "x-allowed-link-types": [
    "supplies",
    "stocks",
    "ordered",
    "shipped_on",
    "owes",
    "substitutes",
    "recalled_with"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id",
    "object_type",
    "object_id",
    "supplier_id",
    "version",
    "properties",
    "valid_from",
    "updated_at"
  ],
  "properties": {
    "cell_id": {
      "type": "string",
      "minLength": 1,
      "description": "Cell/region partition coordinate"
    },
    "object_type": {
      "type": "string",
      "const": "LegalEntity"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique entity identifier within cell+type"
    },
    "supplier_id": {
      "type": "string",
      "description": "Tenant supplier identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic optimistic-concurrency version"
    },
    "security_markings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MARKING:FINANCE_ONLY",
          "MARKING:PII",
          "MARKING:AML_INVESTIGATION",
          "MARKING:DISCREPANT_QUARANTINE",
          "MARKING:THERMAL_QUARANTINE_SPOILED",
          "MARKING:MICRO_SKIMMING_SUSPECT",
          "MARKING:LOT_RECALL_QUARANTINE"
        ]
      },
      "uniqueItems": true,
      "description": "Data governance & quarantine markings"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legal_entity_id": {
          "type": "string",
          "description": "Canonical legal entity identifier"
        },
        "tin": {
          "type": "string",
          "description": "Tax Identification Number / INN (PII)"
        },
        "tax_id": {
          "type": "string",
          "description": "Tax Identification Number alias (PII)"
        },
        "normalized_tax_id": {
          "type": "string",
          "description": "Canonicalized TIN (PII)"
        },
        "company_reg_number": {
          "type": "string",
          "description": "Company registration number"
        },
        "legal_name": {
          "type": "string",
          "description": "Registered legal entity name"
        },
        "entity_kind": {
          "type": "string",
          "description": "SUPPLIER | RETAILER | PAYER"
        },
        "supplier_id": {
          "type": "string",
          "description": "Owning supplier ID"
        },
        "retailer_id": {
          "type": "string",
          "description": "Linked retailer ID if applicable"
        },
        "payer_id": {
          "type": "string",
          "description": "Linked payer ID if applicable"
        },
        "country_code": {
          "type": "string",
          "description": "Country code"
        },
        "gln": {
          "type": "string",
          "description": "GS1 GLN"
        },
        "contact_name": {
          "type": "string",
          "description": "Legal entity contact name (PII)"
        },
        "email": {
          "type": "string",
          "description": "Legal entity contact email (PII)"
        },
        "phone": {
          "type": "string",
          "description": "Legal entity contact phone (PII)"
        },
        "bank_name": {
          "type": "string",
          "description": "Settlement bank name (FINANCE_ONLY)"
        },
        "account_holder": {
          "type": "string",
          "description": "Bank account holder name (PII)"
        },
        "account_number": {
          "type": "string",
          "description": "Bank account number (PII)"
        },
        "iban": {
          "type": "string",
          "description": "IBAN (FINANCE_ONLY/PII)"
        },
        "swift_bic": {
          "type": "string",
          "description": "SWIFT/BIC code (FINANCE_ONLY)"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 8,
          "description": "ISO 4217 currency code"
        },
        "daily_cash_accumulated_minor": {
          "type": "integer",
          "description": "Daily cash accumulated exposure (int64 minor units; zero floats)"
        },
        "daily_cash_ceiling_minor": {
          "type": "integer",
          "description": "Statutory daily cash exposure ceiling (int64 minor units; zero floats)"
        },
        "dedup_cluster_id": {
          "type": "string",
          "description": "Entity resolution cluster ID"
        },
        "dedup_status": {
          "type": "string",
          "description": "Entity resolution status"
        },
        "is_active": {
          "type": "boolean",
          "description": "Active flag"
        }
      }
    }
  }
}
