{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasusx.dev/contracts/ontology/warehouse.v1.schema.json",
  "title": "WarehouseOntologyObjectV1",
  "description": "Fulfillment depot / distribution warehouse.",
  "x-ontology-version": "1.0.0",
  "x-schema-version": "v1",
  "x-object-type": "Warehouse",
  "x-primary-key": [
    "cell_id",
    "object_type",
    "object_id"
  ],
  "x-default-security-markings": [],
  "x-allowed-link-types": [
    "supplies",
    "stocks",
    "ordered",
    "shipped_on",
    "owes",
    "substitutes",
    "recalled_with"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id",
    "object_type",
    "object_id",
    "supplier_id",
    "version",
    "properties",
    "valid_from",
    "updated_at"
  ],
  "properties": {
    "cell_id": {
      "type": "string",
      "minLength": 1,
      "description": "Cell/region partition coordinate"
    },
    "object_type": {
      "type": "string",
      "const": "Warehouse"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique entity identifier within cell+type"
    },
    "supplier_id": {
      "type": "string",
      "description": "Tenant supplier identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic optimistic-concurrency version"
    },
    "security_markings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MARKING:FINANCE_ONLY",
          "MARKING:PII",
          "MARKING:AML_INVESTIGATION",
          "MARKING:DISCREPANT_QUARANTINE",
          "MARKING:THERMAL_QUARANTINE_SPOILED",
          "MARKING:MICRO_SKIMMING_SUSPECT",
          "MARKING:LOT_RECALL_QUARANTINE"
        ]
      },
      "uniqueItems": true,
      "description": "Data governance & quarantine markings"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warehouse_id": {
          "type": "string",
          "description": "Warehouse UUID"
        },
        "supplier_id": {
          "type": "string",
          "description": "Owning supplier ID"
        },
        "name": {
          "type": "string",
          "description": "Warehouse name"
        },
        "country_code": {
          "type": "string",
          "description": "Country code"
        },
        "region_id": {
          "type": "string",
          "description": "Region ID"
        },
        "h3_cell": {
          "type": "string",
          "description": "H3 spatial index"
        },
        "address": {
          "type": "string",
          "description": "Street address"
        },
        "gln": {
          "type": "string",
          "description": "GS1 GLN"
        },
        "primary_factory_id": {
          "type": "string",
          "description": "Primary replenishment factory ID"
        },
        "secondary_factory_id": {
          "type": "string",
          "description": "Secondary replenishment factory ID"
        },
        "transfer_mode": {
          "type": "string",
          "description": "TRUCK | RAIL | AIR"
        },
        "default_out_of_stock_policy": {
          "type": "string",
          "description": "REJECT | ACCEPT_BACKORDER"
        },
        "preorder_min_lead_days": {
          "type": "integer",
          "description": "Minimum pre-order lead days"
        },
        "preorder_max_lead_days": {
          "type": "integer",
          "description": "Maximum pre-order lead days"
        },
        "is_active": {
          "type": "boolean",
          "description": "Active flag"
        },
        "is_on_shift": {
          "type": "boolean",
          "description": "On-shift dispatch availability"
        },
        "auto_dispatch_enabled": {
          "type": "boolean",
          "description": "Auto-dispatch enabled"
        },
        "coverage_radius_km": {
          "type": "number",
          "description": "Service radius in kilometers"
        },
        "lat": {
          "type": "number",
          "description": "Latitude"
        },
        "lng": {
          "type": "number",
          "description": "Longitude"
        }
      }
    }
  }
}
