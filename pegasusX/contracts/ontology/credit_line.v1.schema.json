{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasusx.dev/contracts/ontology/credit_line.v1.schema.json",
  "title": "CreditLineOntologyObjectV1",
  "description": "B2B retailer credit limit, utilization, and payment terms relationship.",
  "x-ontology-version": "1.0.0",
  "x-schema-version": "v1",
  "x-object-type": "CreditLine",
  "x-primary-key": [
    "cell_id",
    "object_type",
    "object_id"
  ],
  "x-default-security-markings": [
    "MARKING:FINANCE_ONLY"
  ],
  "x-allowed-link-types": [
    "supplies",
    "stocks",
    "ordered",
    "shipped_on",
    "owes",
    "substitutes",
    "recalled_with"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id",
    "object_type",
    "object_id",
    "supplier_id",
    "version",
    "properties",
    "valid_from",
    "updated_at"
  ],
  "properties": {
    "cell_id": {
      "type": "string",
      "minLength": 1,
      "description": "Cell/region partition coordinate"
    },
    "object_type": {
      "type": "string",
      "const": "CreditLine"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique entity identifier within cell+type"
    },
    "supplier_id": {
      "type": "string",
      "description": "Tenant supplier identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic optimistic-concurrency version"
    },
    "security_markings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MARKING:FINANCE_ONLY",
          "MARKING:PII",
          "MARKING:AML_INVESTIGATION",
          "MARKING:DISCREPANT_QUARANTINE",
          "MARKING:THERMAL_QUARANTINE_SPOILED",
          "MARKING:MICRO_SKIMMING_SUSPECT",
          "MARKING:LOT_RECALL_QUARANTINE"
        ]
      },
      "uniqueItems": true,
      "description": "Data governance & quarantine markings"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credit_line_id": {
          "type": "string",
          "description": "Composite/UUID credit line ID"
        },
        "supplier_id": {
          "type": "string",
          "description": "Supplier ID"
        },
        "retailer_id": {
          "type": "string",
          "description": "Retailer ID"
        },
        "status": {
          "type": "string",
          "description": "ACTIVE | FROZEN | INACTIVE | SUSPENDED"
        },
        "credit_enabled": {
          "type": "boolean",
          "description": "Credit enabled flag"
        },
        "credit_limit_minor": {
          "type": "integer",
          "description": "Approved credit limit (int64 minor units; zero floats)"
        },
        "current_balance_minor": {
          "type": "integer",
          "description": "Current utilized balance (int64 minor units; zero floats)"
        },
        "reserved_minor": {
          "type": "integer",
          "description": "Pending reserved credit (int64 minor units; zero floats)"
        },
        "available_credit_minor": {
          "type": "integer",
          "description": "Available remaining credit (int64 minor units; zero floats)"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 8,
          "description": "ISO 4217 currency code"
        },
        "terms_days": {
          "type": "integer",
          "description": "Approved net terms days"
        },
        "grace_period_days": {
          "type": "integer",
          "description": "Grace period days"
        },
        "risk_score": {
          "type": "integer",
          "description": "Integer credit risk score"
        },
        "delinquency_count": {
          "type": "integer",
          "description": "Delinquency incident count"
        },
        "use_global_defaults": {
          "type": "boolean",
          "description": "Inherits supplier global defaults"
        },
        "version": {
          "type": "integer",
          "description": "Credit line version"
        }
      }
    }
  }
}
