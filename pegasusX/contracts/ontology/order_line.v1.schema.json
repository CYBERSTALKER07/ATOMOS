{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pegasusx.dev/contracts/ontology/order_line.v1.schema.json",
  "title": "OrderLineOntologyObjectV1",
  "description": "Individual line item within an Order including allocation and partial-offload metrics.",
  "x-ontology-version": "1.0.0",
  "x-schema-version": "v1",
  "x-object-type": "OrderLine",
  "x-primary-key": [
    "cell_id",
    "object_type",
    "object_id"
  ],
  "x-default-security-markings": [
    "MARKING:FINANCE_ONLY"
  ],
  "x-allowed-link-types": [
    "supplies",
    "stocks",
    "ordered",
    "shipped_on",
    "owes",
    "substitutes",
    "recalled_with"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id",
    "object_type",
    "object_id",
    "supplier_id",
    "version",
    "properties",
    "valid_from",
    "updated_at"
  ],
  "properties": {
    "cell_id": {
      "type": "string",
      "minLength": 1,
      "description": "Cell/region partition coordinate"
    },
    "object_type": {
      "type": "string",
      "const": "OrderLine"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique entity identifier within cell+type"
    },
    "supplier_id": {
      "type": "string",
      "description": "Tenant supplier identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic optimistic-concurrency version"
    },
    "security_markings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MARKING:FINANCE_ONLY",
          "MARKING:PII",
          "MARKING:AML_INVESTIGATION",
          "MARKING:DISCREPANT_QUARANTINE",
          "MARKING:THERMAL_QUARANTINE_SPOILED",
          "MARKING:MICRO_SKIMMING_SUSPECT",
          "MARKING:LOT_RECALL_QUARANTINE"
        ]
      },
      "uniqueItems": true,
      "description": "Data governance & quarantine markings"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order_line_id": {
          "type": "string",
          "description": "Order line identifier"
        },
        "order_id": {
          "type": "string",
          "description": "Parent Order UUID"
        },
        "supplier_id": {
          "type": "string",
          "description": "Supplier ID"
        },
        "warehouse_id": {
          "type": "string",
          "description": "Allocated warehouse ID"
        },
        "product_id": {
          "type": "string",
          "description": "Product UUID"
        },
        "sku": {
          "type": "string",
          "description": "SKU code"
        },
        "substitute_sku": {
          "type": "string",
          "description": "Substitute SKU code if replaced"
        },
        "original_sku": {
          "type": "string",
          "description": "Original requested SKU before substitution"
        },
        "name": {
          "type": "string",
          "description": "Line item title"
        },
        "quantity": {
          "type": "integer",
          "description": "Ordered quantity"
        },
        "delivered_qty": {
          "type": "integer",
          "description": "Delivered quantity"
        },
        "remaining_qty": {
          "type": "integer",
          "description": "Remaining/undelivered quantity"
        },
        "unit_price_minor": {
          "type": "integer",
          "description": "Unit price (int64 minor units; zero floats)"
        },
        "line_total_minor": {
          "type": "integer",
          "description": "Extended line total (int64 minor units; zero floats)"
        },
        "vat_minor": {
          "type": "integer",
          "description": "Line VAT amount (int64 minor units; zero floats)"
        },
        "price_gap_minor": {
          "type": "integer",
          "description": "Substitution price differential (int64 minor units; zero floats)"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 8,
          "description": "ISO 4217 currency code"
        },
        "ikpu_code": {
          "type": "string",
          "description": "Soliq IKPU code"
        },
        "package_code": {
          "type": "string",
          "description": "Soliq package code"
        },
        "allocation_mode": {
          "type": "string",
          "description": "Allocation strategy"
        },
        "offload_status": {
          "type": "string",
          "description": "Line delivery offload status"
        }
      }
    }
  }
}
