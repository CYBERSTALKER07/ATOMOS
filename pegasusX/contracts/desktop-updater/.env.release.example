# Desktop release secrets — copy to repo-root `.env.staging.secrets` (gitignored)
# Sync: `bash scripts/sync_desktop_release_secrets.sh`

# Minisign private key (full string or path content) — NEVER commit production value
TAURI_SIGNING_PRIVATE_KEY=

# Optional password when minisign key is encrypted
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Minisign public key (single line) — injected into tauri.conf.json at build
TAURI_UPDATER_PUBKEY=

# Windows Authenticode — base64-encoded .pfx (EV cert)
WINDOWS_CODESIGN_PFX_B64=

# Password for the PFX
WINDOWS_CODESIGN_PASSWORD=

# macOS notarization (release train)
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Org (TEAMID)"
APPLE_NOTARIZE_APPLE_ID=
APPLE_NOTARIZE_TEAM_ID=
APPLE_NOTARIZE_APP_PASSWORD=

# GCS upload target (defaults to terraform bucket name)
DESKTOP_UPDATES_GCS_BUCKET=pegasusx-ssmr-app-updates
