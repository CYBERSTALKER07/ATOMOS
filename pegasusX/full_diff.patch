diff --git a/pegasusX/apps/warehouse-app-ios/WarehouseApp/warehouseapp/Services/EnterpriseUpdateConfig.swift b/pegasusX/apps/warehouse-app-ios/WarehouseApp/warehouseapp/Services/EnterpriseUpdateConfig.swift
