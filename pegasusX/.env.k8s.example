# K8s render env — copy to .env.k8s or use make render-k8s-from-terraform after terraform apply.
# See scripts/render_k8s_manifests.sh

GCP_PROJECT_ID=your-gcp-project-id
GCP_RUNTIME_SA_EMAIL=staging-backend@your-gcp-project-id.iam.gserviceaccount.com

# After: make docker-build && terraform output artifact_registry_url
BACKEND_IMAGE=asia-south1-docker.pkg.dev/your-gcp-project-id/pegasusx-staging-images/backend-go:latest
AI_WORKER_IMAGE=asia-south1-docker.pkg.dev/your-gcp-project-id/pegasusx-staging-images/ai-worker:latest

# GSM secret ids (terraform output jwt_secret_id, etc.)
JWT_SECRET_GSM=pegasusx-staging-jwt-secret
GLOBAL_PAY_GSM=pegasusx-staging-global-pay-webhook-secret
ADYEN_GSM=pegasusx-staging-adyen-webhook-secret
STRIPE_GSM=pegasusx-staging-stripe-webhook-secret
GOOGLE_MAPS_GSM=pegasusx-staging-google-maps-api-key

# Optional — patched into rendered configmap when set
# SPANNER_PROJECT=
# SPANNER_INSTANCE=
# SPANNER_DATABASE=
# REDIS_ADDR=
# KAFKA_BROKERS=
